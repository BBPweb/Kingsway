---
import { home, navigation } from "../../data/home";
import Arrow from "./Arrow.astro";
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class:list={["home-header", { "is-tinted": solid, "is-solid": solid }]} data-home-header data-header-solid={solid || undefined}>
  <div class="home-header-inner">
    <a class="home-brand" href="/" aria-label="Kingsway International — home">
      <img
        src={home.brand.logo}
        alt=""
        width="66"
        height="66"
        fetchpriority="low"
      />
      <span>
        <strong>Kingsway</strong>
        <small>International</small>
      </span>
    </a>
    <nav class="home-desktop-nav" aria-label="Primary navigation">
      {navigation.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a class="home-header-cta" href={home.tradeLink.href}>
      {home.tradeLink.label}
      <Arrow />
    </a>
    <button
      type="button"
      class="home-menu-toggle"
      aria-controls="home-menu"
      aria-expanded="false"
      aria-label="Open navigation menu"
      data-menu-open
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<dialog id="home-menu" class="home-menu" aria-label="Navigation menu">
  <button
    type="button"
    class="home-menu-close"
    aria-label="Close navigation menu"
    data-menu-close
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M2 2L18 18M18 2L2 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
  <nav aria-label="Mobile navigation">
    <ul class="home-menu-list">
      {navigation.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={["home-menu-link", { "home-menu-link--active": isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="home-menu-cta" href={home.tradeLink.href}>
    {home.tradeLink.label}
    <Arrow />
  </a>
</dialog>
<noscript>
  <nav class="home-nojs-nav" aria-label="Mobile navigation">
    {navigation.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</noscript>
