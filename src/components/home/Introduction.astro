---
import { home } from "../../data/home";
import Arrow from "./Arrow.astro";
import FloatingIngredient from "./FloatingIngredient.astro";
---

<section
  class="home-intro home-section"
  id="introduction"
  aria-labelledby="intro-title"
>
  <div class="home-container intro-grid">
    <div>
      <p class="home-kicker" data-reveal>
        {home.intro.eyebrow}
      </p>
      <h2 class="intro-title" id="intro-title" data-reveal>
        {home.intro.title.map((line, i) =>
          i === 1 ? <em>{line}</em> : <span>{line}</span>,
        )}
      </h2>
    </div>
    <div class="intro-copy" data-reveal>
      <p>{home.intro.body}</p>
      <p>{home.intro.detail}</p>
      <a class="home-text-link" href={home.intro.link.href}>
        {home.intro.link.label}
        <Arrow />
      </a>
    </div>
  </div>
  <div class="home-container intro-signoff">
    <span>{home.intro.note}</span>
    <span class="intro-rule"></span>
    <FloatingIngredient
      ingredient="cinnamon"
      class="intro-cinnamon"
      speed={25}
      rotation={3}
    />
  </div>
</section>
