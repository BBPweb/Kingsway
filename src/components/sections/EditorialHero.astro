---
interface Props {
  eyebrow: string;
  title: string;
  highlight: string;
  subtitle: string;
  backgroundImage: string;
  breadcrumb: string;
}

const { eyebrow, title, highlight, subtitle, backgroundImage, breadcrumb } = Astro.props;
const highlightStart = title.indexOf(highlight);
---

<header class="editorial-hero" aria-labelledby="hero-title">
  <div class="editorial-orb editorial-orb--gold" aria-hidden="true"></div>
  <div class="editorial-orb editorial-orb--blue" aria-hidden="true"></div>
  <div class="editorial-container">
    <nav class="hero-breadcrumb editorial-breadcrumb" aria-label="Breadcrumb navigation">
      <ol class="hero-breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" class="hero-breadcrumb-link" itemprop="item">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true" class="hero-breadcrumb-sep">/</li>
        <li class="hero-breadcrumb-current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{breadcrumb}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </nav>
    <div class="editorial-hero-grid">
      <div class="editorial-hero-copy">
        <p class="editorial-kicker">{eyebrow}</p>
        <h1 id="hero-title">{title.slice(0, highlightStart)}<span>{highlight}</span>{title.slice(highlightStart + highlight.length)}</h1>
        <p class="editorial-hero-subtitle">{subtitle}</p>
      </div>
      <div class="editorial-hero-media">
        <img src={backgroundImage} alt="" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
</header>

