---
const currentYear = new Date().getFullYear();
interface Props { wordmarkLabel?: string; }
const { wordmarkLabel = 'Kingsway International, home' } = Astro.props;

const exploreLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Quality', href: '/quality' },
  { label: 'Products', href: '/products' },
  { label: 'Who We Serve', href: '/who-we-serve' },
  { label: 'Food Stories', href: '/food-stories' },
  { label: 'Contact', href: '/contact' },
];

const tradeLinks = [
  { label: 'Start a trade conversation', href: '/contact' },
  { label: 'Become a supplier', href: '/contact/become-a-supplier' },
  { label: 'Request a catalogue', href: '/contact' },
  { label: 'Enquire about private label', href: '/contact' },
  { label: 'Download policy pack', href: '/policies' },
];

const legalLinks = [
  { label: 'Privacy Notice', href: '/privacy-notice' },
  { label: 'Terms of Use', href: '/terms-of-use' },
  { label: 'Cookie Policy', href: '/cookie-policy' },
  { label: 'Modern Slavery Statement', href: '/modern-slavery-statement' },
];
---

<footer class="site-footer" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site footer</h2>

  <div class="footer-inner">
    <div class="footer-grid">

      <!-- Column 1: Brand -->
      <div class="footer-col footer-brand">
        <a href="/" class="footer-wordmark" aria-label={wordmarkLabel}>
          <span class="wordmark-primary">KINGSWAY</span>
          <span class="wordmark-tag">TRADING &amp; DISTRIBUTION</span>
        </a>
        <p class="footer-tagline">
          UK Ethnic Food Trading &amp; Distribution
        </p>
        <address class="footer-address">
          <p>Registered office address</p>
          <p>Unit 1, 75 Hastings Road, Leicester.</p>
        </address>
      </div>

      <!-- Column 2: Explore -->
      <div class="footer-col">
        <h3 class="footer-col-heading">Explore</h3>
        <ul class="footer-links" role="list">
          {exploreLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Trade -->
      <div class="footer-col">
        <h3 class="footer-col-heading">Trade</h3>
        <ul class="footer-links" role="list">
          {tradeLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact & Legal -->
      <div class="footer-col">
        <h3 class="footer-col-heading">Contact</h3>
        <ul class="footer-links footer-contact-list" role="list">
          <li>
            <a href="mailto:info@kingswayinternational.co.uk" class="footer-link">
              info@kingswayinternational.co.uk
            </a>
          </li>
          <li class="footer-phone">Phone</li>
           <li class="footer-phone"><a href="tel:">
</a></li>
        </ul>
        <h3 class="footer-col-heading footer-col-heading--legal">Legal</h3>
        <ul class="footer-links" role="list">
          {legalLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link footer-link--small">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

    </div><!-- /.footer-grid -->
  </div><!-- /.footer-inner -->

  <!-- Base line -->
  <div class="footer-base">
    <p class="footer-copyright">
      &copy; {currentYear} Kingsway International Ltd. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: #101d42;
    color: rgba(247, 239, 222, 0.7);
    font-family: var(--font-sans);
  }

  .footer-inner {
    max-width: 1432px;
    margin: 0 auto;
    padding: 78px 56px 60px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.8fr 1fr 1.15fr;
    gap: 45px;
  }

  /* Brand column with Homepage circular white logo badge */
  .footer-brand::before {
    content: "";
    display: block;
    width: 64px;
    height: 64px;
    background: white url("/images/home/logo.webp") center / contain no-repeat;
    border-radius: 50%;
    margin-bottom: 24px;
  }

  .footer-wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1.25rem;
    text-decoration: none;
  }

  .wordmark-primary {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: #FAF9F6;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .wordmark-tag {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #D9A441;
    line-height: 1;
  }

  .footer-tagline {
    font-size: 0.9375rem;
    line-height: 1.55;
    margin-bottom: 1.15rem;
    color: #bdc3d1;
  }

  .footer-address {
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #bdc3d1;
  }

  /* Column headings */
  .footer-col-heading {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #D9A441;
    margin-bottom: 1.25rem;
  }

  .footer-col-heading--legal {
    margin-top: 1.75rem;
  }

  /* Links */
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: rgba(247, 239, 222, 0.78);
    text-decoration: none;
    line-height: 1.45;
    transition: color 0.2s ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: #F4BF4F;
  }

  .footer-link--small {
    font-size: 0.8125rem;
  }

  .footer-contact-list a {
    overflow-wrap: anywhere;
  }

  .footer-phone {
    font-size: 0.875rem;
    color: #bdc3d1;
  }

  /* Base line */
  .footer-base {
    border-top: 1px solid rgba(247, 239, 222, 0.15);
    padding: 22px 56px;
    text-align: center;
  }

  .footer-copyright {
    font-size: 0.8125rem;
    color: #bdc3d1;
    margin: 0;
  }

  /* ── Responsive ── */

  /* Tablet: 2 columns */
  @media (max-width: 900px) {
    .footer-inner {
      padding-inline: 40px;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 767px) {
    .footer-inner {
      padding: 60px 22px 40px;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 35px 20px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-grid .footer-col:last-child {
      grid-column: 1 / -1;
    }

    .footer-link,
    .footer-address {
      font-size: 0.875rem;
    }

    .footer-col-heading {
      font-size: 0.75rem;
    }

    .footer-base {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
