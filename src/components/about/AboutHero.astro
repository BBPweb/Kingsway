---
import { about } from '../../data/about';
import Arrow from '../home/Arrow.astro';
const { hero } = about;
---
<section class="about-hero" aria-labelledby="about-title">
  <picture class="about-hero-picture">
    <img
      src={hero.image}
      srcset={hero.imageSrcSet}
      sizes="(max-width: 900px) 180vw, (max-width: 1050px) 220vw, 150vw"
      alt={hero.alt}
      width="1980"
      height="600"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="about-container about-hero-content">
    <div class="about-hero-copy">
      <p class="about-eyebrow"><span class="about-small-rule" aria-hidden="true"></span> {hero.eyebrow}</p>
      <h1 id="about-title"><span>{hero.title[0]}</span><em>{hero.title[1]}</em></h1>
      <p class="about-hero-description">{hero.description}</p>
      <div class="about-actions">
        <a href="#our-story" class="home-button">Discover our story <Arrow /></a>
        <a href="/products" class="home-text-link">Explore our range <Arrow /></a>
      </div>
    </div>
  </div>
  <div class="about-hero-footer">
    <div class="about-container about-hero-bottom">
      <a href="#our-story" class="about-scroll-link"><span aria-hidden="true">↓</span> The heart of Kingsway</a>
      <p class="about-hero-caption">{hero.caption}</p>
      <ul class="about-hero-notes" aria-label="What we bring to your table">
        {hero.notes.map(note => <li>{note}</li>)}
      </ul>
    </div>
  </div>
</section>
