---
interface Props {
  heading: string;
  caption: string;
  buttonLabel: string;
  buttonHref: string;
}
const { heading, caption, buttonLabel, buttonHref } = Astro.props;
---

<section class="editorial-cta-section" aria-labelledby="cta-banner-heading">
  <div class="editorial-container">
    <div class="editorial-cta-card">
      <div>
        <h2 id="cta-banner-heading">{heading}</h2>
        <p>{caption}</p>
      </div>
      <a href={buttonHref} class="editorial-cta-button">
        {buttonLabel}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

