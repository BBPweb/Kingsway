---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import AboutHero from '../components/about/AboutHero.astro';
import OurStory from '../components/about/OurStory.astro';
import OurMission from '../components/about/OurMission.astro';
import Values from '../components/about/Values.astro';
import SourceToShelf from '../components/about/SourceToShelf.astro';
import AboutPortfolio from '../components/about/AboutPortfolio.astro';
import GlobalReach from '../components/about/GlobalReach.astro';
import QualityPromise from '../components/about/QualityPromise.astro';
import Partnership from '../components/about/Partnership.astro';
import AboutCTA from '../components/about/AboutCTA.astro';
import { about } from '../data/about';
import '../styles/home.css';
import '../styles/about.css';
---
<BaseLayout title={about.seo.title} description={about.seo.description} ogImage={about.seo.image} bodyClass="about-page">
  <Fragment slot="head"><link rel="preload" as="image" type="image/webp" href={about.hero.image} imagesrcset={about.hero.imageSrcSet} imagesizes="(max-width: 900px) 180vw, (max-width: 1050px) 220vw, 150vw" fetchpriority="high" /></Fragment>
  <HomeHeader slot="header" solid />
  <AboutHero /><OurStory /><OurMission /><Values /><SourceToShelf /><AboutPortfolio /><GlobalReach /><QualityPromise /><Partnership /><AboutCTA />
</BaseLayout>
<script>
  import { initAbout } from '../scripts/about';
  initAbout();
</script>
