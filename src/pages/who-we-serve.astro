    background: #ffffff;
    border: 1px solid rgba(217, 164, 65, 0.35);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(11, 28, 54, 0.04);
  }

  .quick-pill:hover {
    background: var(--deep-navy);
    color: #ffffff;
    border-color: var(--deep-navy);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(11, 28, 54, 0.16);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     RIGHT SHOWCASE: REALISTIC MULTI-LAYERED FLOATING ARCHITECTURE
     ══════════════════════════════════════════════════════════════════════════ */
  .inner-hero-showcase {
    position: relative;
    width: 100%;
  }

  .floating-stage-container {
    position: relative;
    width: 100%;
    perspective: 1200px;
    padding: 1.5rem 1rem 2rem;
  }

  .stage-backdrop-glow {
    position: absolute;
    inset: 10%;
    background: radial-gradient(ellipse at center, rgba(217, 164, 65, 0.25) 0%, transparent 70%);
    filter: blur(40px);
    z-index: 1;
    pointer-events: none;
  }

  /* Sculpted Image Showcase with Depth */
  .hero-sculpted-frame {
    position: relative;
    z-index: 2;
    width: 100%;
    aspect-ratio: 4 / 3.25;
    overflow: visible;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-sculpted-frame:hover {
    transform: translateY(-4px) rotateX(1deg);
  }

  .hero-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 30%;
    border-radius: 36px 140px 36px 90px;
    box-shadow:
      0 25px 60px -12px rgba(11, 28, 54, 0.26),
      0 0 0 1px rgba(217, 164, 65, 0.35);
  }

  .showcase-halo-border {
    position: absolute;
    inset: -7px;
    border-radius: 42px 146px 42px 96px;
    border: 2px solid var(--champagne-gold);
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .showcase-glass-sheen {
    position: absolute;
    inset: 0;
    border-radius: 36px 140px 36px 90px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18) 0%,
      transparent 50%,
      rgba(11, 28, 54, 0.25) 100%
    );
    pointer-events: none;
  }

  /* Floated Element 1: Top-Right Glass Pill with Pulse */
  .floating-badge-top {
    position: absolute;
    top: 0;
    right: -10px;
    z-index: 5;
    background: rgba(11, 28, 54, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(217, 164, 65, 0.45);
    border-radius: 9999px;
    padding: 0.6rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    box-shadow: 0 14px 30px -4px rgba(11, 28, 54, 0.35);
    animation: floatGentle1 6s ease-in-out infinite;
  }

  .pulse-indicator {
    position: relative;
    width: 8px;
    height: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
  }

  .pulse-ring {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: rgba(217, 164, 65, 0.4);
    animation: pulseWave 2s ease-out infinite;
  }

  @keyframes pulseWave {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .badge-label-strong {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
  }

  .badge-label-sub {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--champagne-gold);
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    padding-left: 0.5rem;
  }

  /* Floated Element 2: Bottom-Left Luxury Stat Card */
  .floating-stat-card {
    position: absolute;
    bottom: -20px;
    left: -20px;
    z-index: 5;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(217, 164, 65, 0.35);
    border-radius: 18px;
    padding: 1rem 1.4rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 20px 42px -8px rgba(11, 28, 54, 0.22);
    animation: floatGentle2 7s ease-in-out infinite;
  }

  .stat-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FAF4E6;
    border: 1px solid rgba(217, 164, 65, 0.3);
    flex-shrink: 0;
  }

  .stat-text-wrap {
    display: flex;
    flex-direction: column;
  }

  .stat-main {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--deep-navy);
    line-height: 1.25;
  }

  .stat-sub {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: #64748B;
    line-height: 1.35;
  }

  /* Floated Element 3: Bottom-Right Guarantee Pill */
  .floating-guarantee-pill {
    position: absolute;
    bottom: 24px;
    right: -12px;
    z-index: 4;
    background: #ffffff;
    border: 1px solid rgba(217, 164, 65, 0.3);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--deep-navy);
    box-shadow: 0 10px 24px -4px rgba(11, 28, 54, 0.14);
    animation: floatGentle3 6.5s ease-in-out infinite;
  }

  .guarantee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
    color: var(--deep-navy);
    font-size: 0.625rem;
    font-weight: 900;
  }

  /* Gentle Floating Keyframe Animations */
  @keyframes floatGentle1 {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes floatGentle2 {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(7px);
    }
  }

  @keyframes floatGentle3 {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     TRUST STRIP
     ══════════════════════════════════════════════════════════════════════════ */
  .section-trust-strip {
    background-color: var(--warm-white);
    padding: 2rem 0;
  }

  .trust-strip {
    background: #ffffff;
    border-radius: 9999px;
    padding: 1.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 14px 32px -8px rgba(11, 28, 54, 0.1), 0 0 0 1px rgba(217, 164, 65, 0.18);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    justify-content: center;
  }

  .trust-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #FAF4E6;
    border: 1px solid rgba(217, 164, 65, 0.25);
    flex-shrink: 0;
  }

  .trust-text {
    display: flex;
    flex-direction: column;
  }

  .trust-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--deep-navy);
    line-height: 1.2;
  }

  .trust-sub {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: #64748B;
    line-height: 1.3;
  }

  .trust-divider {
    width: 1px;
    height: 36px;
    background: #E2E8F0;
    margin: 0 0.75rem;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     MAIN CHANNELS SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .section-channels {
    background-color: var(--warm-white);
    padding: 2rem 0 6rem;
  }

  .channel-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.5rem;
    align-items: center;
    padding: 5rem 0;
    border-top: 1px solid rgba(229, 229, 229, 0.7);
  }

  .channel-card:first-child {
    border-top: none;
    padding-top: 2rem;
  }

  /* Reversed layout on desktop */
  .channel-card--reversed .channel-text-col {
    order: 2;
  }

  .channel-card--reversed .channel-visual-col {
    order: 1;
  }

  /* Text column elements */
  .phase-pill-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .phase-pill {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    line-height: 1;
  }

  .phase-pill--gold {
    background-color: var(--champagne-gold);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(217, 164, 65, 0.25);
  }

  .phase-pill--outline {
    background-color: transparent;
    border: 1.5px solid var(--champagne-gold);
    color: var(--champagne-gold);
  }

  .channel-category-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748B;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .channel-title {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 2.7vw, 2.5rem);
    line-height: 1.2;
    font-weight: 400;
    color: var(--deep-navy);
    margin: 0 0 1.25rem;
  }

  .channel-body {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--body-text);
    margin: 0 0 1.75rem;
  }

  .channel-body strong {
    color: var(--deep-navy);
    font-weight: 600;
  }

  /* Luxury Check List with Gold Badges */
  .luxury-check-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .luxury-check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--body-text);
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #FAF4E6;
    color: var(--champagne-gold);
    border: 1px solid rgba(217, 164, 65, 0.35);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* Channel Action Button */
  .channel-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    background-color: var(--deep-navy);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(11, 28, 54, 0.15);
  }

  .channel-action-btn:hover {
    background-color: var(--royal-navy);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(11, 28, 54, 0.25);
  }

  .channel-action-btn--gold {
    background-color: var(--champagne-gold);
    color: var(--deep-navy);
  }

  .channel-action-btn--gold:hover {
    background-color: var(--gold-light);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     DISTINCT ASYMMETRIC IMAGE FRAMING (NOT FLAT RECTANGLES)
     ══════════════════════════════════════════════════════════════════════════ */
  .image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: visible;
    transition: transform 0.4s ease;
  }

  .image-frame:hover {
    transform: translateY(-4px);
  }

  .channel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 20px 40px -12px rgba(11, 28, 54, 0.2);
    transition: transform 0.6s ease;
  }

  .image-frame:hover .channel-img {
    transform: scale(1.02);
  }

  /* Organic Silhouette 1: Retail */
  .frame-organic-retail .channel-img {
    border-radius: 24px 120px 24px 80px;
  }

  .frame-organic-retail .image-halo-stroke {
    position: absolute;
    inset: -6px;
    border-radius: 28px 124px 28px 84px;
    border: 2px solid var(--gold-border);
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .image-frame:hover .image-halo-stroke {
    opacity: 1;
    border-color: var(--champagne-gold);
  }

  /* Floating Navy Badge on Retail */
  .floating-badge-navy {
    position: absolute;
    bottom: -18px;
    right: 24px;
    background-color: var(--deep-navy);
    color: #ffffff;
    padding: 0.75rem 1.4rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    box-shadow: 0 12px 24px -4px rgba(11, 28, 54, 0.4);
    border: 1px solid rgba(217, 164, 65, 0.3);
    transition: all 0.25s ease;
    z-index: 5;
  }

  .floating-badge-navy:hover {
    background-color: var(--royal-navy);
    transform: translateY(-2px);
    box-shadow: 0 16px 28px -4px rgba(11, 28, 54, 0.55);
  }

  .badge-arrow-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
    color: var(--deep-navy);
  }

  /* Organic Silhouette 2: Wholesale */
  .frame-organic-wholesale .channel-img {
    border-radius: 100px 24px 80px 24px;
  }

  .frame-organic-wholesale .image-halo-stroke {
    position: absolute;
    inset: -6px;
    border-radius: 104px 28px 84px 28px;
    border: 2px solid var(--gold-border);
    pointer-events: none;
    opacity: 0.6;
  }

  .dot-grid-accent {
    position: absolute;
    top: -24px;
    right: -24px;
    width: 140px;
    height: 140px;
    background-image: radial-gradient(var(--champagne-gold) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
    opacity: 0.45;
    z-index: -1;
  }

  .center-inspect-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 2px solid var(--champagne-gold);
    color: var(--deep-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .center-inspect-btn:hover {
    transform: translate(-50%, -50%) scale(1.12);
    background: #ffffff;
    color: var(--champagne-gold);
  }

  /* Organic Silhouette 3: Food Service */
  .frame-organic-chef .channel-img {
    border-radius: 60px 140px 60px 140px;
  }

  .frame-organic-chef .image-halo-stroke {
    position: absolute;
    inset: -6px;
    border-radius: 64px 144px 64px 144px;
    border: 2px solid var(--gold-border);
    pointer-events: none;
    opacity: 0.6;
  }

  /* Organic Silhouette 4: Multiples */
  .frame-organic-multiples .channel-img {
    border-radius: 120px 30px 100px 30px;
  }

  .frame-organic-multiples .image-halo-stroke {
    position: absolute;
    inset: -6px;
    border-radius: 124px 34px 104px 34px;
    border: 2px solid var(--gold-border);
    pointer-events: none;
    opacity: 0.6;
  }

  /* Organic Silhouette 5: Export */
  .frame-organic-export {
    aspect-ratio: 16 / 9;
  }

  .frame-organic-export .channel-img {
    border-radius: 40px 140px 40px 120px;
  }

  .frame-organic-export .image-halo-stroke {
    position: absolute;
    inset: -6px;
    border-radius: 44px 144px 44px 124px;
    border: 2px solid var(--gold-border);
    pointer-events: none;
    opacity: 0.6;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION: COMMITMENT NAVY BANNER
     ══════════════════════════════════════════════════════════════════════════ */
  .section-commitment {
    background: linear-gradient(135deg, var(--deep-navy) 0%, #11284E 100%);
    color: #ffffff;
    padding: 3.5rem 0;
    position: relative;
    overflow: hidden;
    border-top: 2px solid var(--champagne-gold);
    border-bottom: 2px solid var(--champagne-gold);
  }

  .commitment-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .commitment-grid {
    display: grid;
    grid-template-columns: auto 1.3fr 2fr;
    gap: 2.5rem;
    align-items: center;
  }

  .commitment-brand-badge {
    display: flex;
    align-items: center;
  }

  .spice-bowl-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--champagne-gold);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    background-color: #17243C;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spice-bowl-img {
    width: 90%;
    height: 90%;
    object-fit: contain;
  }

  .commitment-center {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .commitment-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    line-height: 1.25;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
  }

  .commitment-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .metric-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 0.75rem 0.5rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .metric-pill:last-child {
    border-right: none;
  }

  .metric-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(217, 164, 65, 0.15);
  }

  .metric-info {
    display: flex;
    flex-direction: column;
  }

  .metric-value {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .metric-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--champagne-gold);
    line-height: 1.2;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION: DISTRIBUTION AT A GLANCE (Matrix Table)
     ══════════════════════════════════════════════════════════════════════════ */
  .section-matrix {
    background-color: #ffffff;
    padding: 5.5rem 0;
  }

  .section-header-centered {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .gold-subheading {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--champagne-gold);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-headline {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.2;
    color: var(--deep-navy);
    margin: 0 0 1rem;
    font-weight: 400;
  }

  .section-lead-centered {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--body-text);
    line-height: 1.6;
    margin: 0;
  }

  .matrix-table-wrap {
    overflow-x: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px -5px rgba(11, 28, 54, 0.08);
    border: 1px solid var(--subtle-rule);
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .matrix-table thead {
    background-color: var(--deep-navy);
    color: #ffffff;
  }

  .matrix-table th {
    padding: 1.15rem 1.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--champagne-gold);
    white-space: nowrap;
  }

  .matrix-table td {
    padding: 1.15rem 1.5rem;
