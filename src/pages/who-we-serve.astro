---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/ui/CTABanner.astro';

type Phase = '1' | '2';

interface Channel {
  slug: string;
  phase: Phase;
  phaseDisplay: string;
  title: string;
  body: string;
  bullets: string[];
  ctaLabel: string;
  ctaHref: string;
  imageLabel: string;
  image: string;
  shapeClass: string;
  badge?: string;
}

const channels: Channel[] = [
  {
    slug: 'retail',
    phase: '1',
    phaseDisplay: 'PHASE 1',
    title: 'Independent retail & convenience',
    body: 'Independent grocers, specialist ethnic stores and convenience retailers are the backbone of ethnic food distribution in the UK. They demand flexibility, reliability and fair pricing, in that order.',
    bullets: [
      'Flexible pack sizes from single-unit retail to inner-case formats.',
      'Reliable weekly delivery schedules through direct trading relationships and regional distribution partners.',
      'Competitive wholesale pricing, transparent, with no hidden rebates or conditional discounts.',
      'Merchandising and shelf-ready packaging support where required.',
    ],
    ctaLabel: 'Enquire for Retail',
    ctaHref: '/contact?subject=retail',
    imageLabel: 'Independent retail grocery aisle with shelves of authentic foods',
    image: '/assets/retail-store.jpg',
    shapeClass: 'shape-retail',
    badge: 'Your Trusted Distribution Partner',
  },
  {
    slug: 'wholesale',
    phase: '1',
    phaseDisplay: 'PHASE 1',
    title: 'Cash & carry and wholesale',
    body: 'National and regional cash-and-carry operators need volume, price discipline and a trading partner who respects margin structures. Kingsway will support this channel through:',
    bullets: [
      'Bulk pack formats for high-velocity categories, rice, pulses, oils.',
      'A promotional calendar developed with buyer input, not imposed on them.',
      'Clear trading terms published in writing, including payment terms and minimum order quantities.',
      'Responsive account management for new listings, promotions and seasonal peaks.',
    ],
    ctaLabel: 'Wholesale Trade Enquiry',
    ctaHref: '/contact?subject=wholesale',
    imageLabel: 'Modern cash and carry warehouse depot with pallet racking and forklift',
    image: '/assets/wholesale-warehouse.jpg',
    shapeClass: 'shape-wholesale',
  },
  {
    slug: 'foodservice',
    phase: '1',
    phaseDisplay: 'PHASE 1',
    title: 'Food service',
    body: 'Restaurants, caterers and institutional kitchens require catering-pack formats, consistency of supply, and ingredient provenance that can be stood behind. This is a natural fit for a distributor whose sourcing discipline is a visible strength.',
    bullets: [
      'Catering pack formats matched to kitchen needs, not just to warehouse convenience.',
      'Consistency of specification, order-to-order, season-to-season.',
      'Provenance-led category advice for menu development.',
      'Direct access to a named account owner for every food service customer.',
    ],
    ctaLabel: 'Food Service Partner Enquiry',
    ctaHref: '/contact?subject=foodservice',
    imageLabel: 'Professional executive chef in a commercial kitchen preparing gourmet dishes',
    image: '/assets/commercial-kitchen-chef.jpg',
    shapeClass: 'shape-foodservice',
  },
  {
    slug: 'multiples',
    phase: '2',
    phaseDisplay: 'PHASE 2',
    title: 'Grocery multiples',
    body: 'We will approach national grocery multiples once our own-brand programme is proven and our operational track record is established. This phased approach protects category relationships and reputation, for the multiple and for us. Multiples interested in exploring a conversation ahead of Phase 2 are very welcome to get in touch now.',
    bullets: [],
    ctaLabel: 'Discuss Multiples Partnership',
    ctaHref: '/contact?subject=multiples',
    imageLabel: 'Modern supermarket grocery multiple aisles',
    image: '/assets/supermarket-multiples.jpg',
    shapeClass: 'shape-multiples',
  },
  {
    slug: 'export',
    phase: '2',
    phaseDisplay: 'PHASE 2',
    title: 'Export',
    body: 'Selected European markets, particularly those with comparable diaspora communities, will be addressed in Phase 2, using UK-based consolidation to serve EU buyers efficiently. Early export partner conversations are welcome.',
    bullets: [],
    ctaLabel: 'Explore Export Opportunities',
    ctaHref: '/contact?subject=export',
    imageLabel: 'International maritime cargo container ship departing harbor port',
    image: '/assets/export-shipping-port.jpg',
    shapeClass: 'shape-export',
  },
];

const channelMatrix = [
  {
    channel: 'Independent Retail',
    minOrder: 'Flexible inner-case MOQ',
    delivery: 'Weekly scheduled drops',
    packaging: 'Single-unit & shelf-ready',
    accountLead: 'Dedicated regional rep',
  },
  {
    channel: 'Cash & Carry / Wholesale',
    minOrder: 'Full pallet / mixed pallet',
    delivery: 'National consolidated freight',
    packaging: 'Bulk catering & outer cartons',
    accountLead: 'Wholesale commercial director',
  },
  {
    channel: 'Food Service & Catering',
    minOrder: 'Catering case minimums',
    delivery: '24-48hr kitchen replenishment',
    packaging: 'Foodservice tubs & bulk sacks',
    accountLead: 'Named foodservice specialist',
  },
  {
    channel: 'Grocery Multiples (Phase 2)',
    minOrder: 'Volume contract supply',
    delivery: 'Central distribution hub (RDC)',
    packaging: 'Retail own-brand & branded',
    accountLead: 'Key account team',
  },
  {
    channel: 'Export Partners (Phase 2)',
    minOrder: 'Container / sea-freight loads',
    delivery: 'Consolidated UK port dispatch',
    packaging: 'Export-compliant labelling',
    accountLead: 'International trade desk',
  },
];

const faqs = [
  {
    question: 'How do I open a new trade account with Kingsway International?',
    answer: 'Opening an account takes less than 24 hours. Contact our commercial team via our trade enquiry form, specify your primary channel (retail, wholesale, or food service), and our dedicated sector manager will contact you with product specifications, pricing sheets, and onboarding forms.',
  },
  {
    question: 'What are your delivery schedules and coverage across the United Kingdom?',
    answer: 'We provide nationwide UK coverage through scheduled direct fleet deliveries and established regional logistics partners. Delivery lead times and minimum drop values are tailored to your trade channel to ensure maximum commercial viability.',
  },
  {
    question: 'Can restaurants and caterers order product samples for menu development?',
    answer: 'Yes. We encourage chefs and food service operators to test our authentic spices, rice varieties, pulses, and ingredients. Sample requests can be submitted directly through our contact page or through your named account manager.',
  },
  {
    question: 'What quality certifications and compliance documentation do you provide?',
    answer: 'Every lot distributed through Kingsway is backed by our five-stage quality framework, origin testing certificates, phytosanitary records, and allergen declarations. Our full technical specification pack is accessible to all verified trade buyers.',
  },
];
---

<BaseLayout
  title="Who We Serve | Retail, Wholesale, Foodservice & Export | Kingsway International"
  description="Kingsway International delivers authentic ethnic food ingredients across the UK with dedicated commercial strategies for independent retail, cash & carry, wholesale, food service, grocery multiples, and export."
>
  <!-- ══════════════════════════════════════════════════════════════════════════
       INNER-PAGE EDITORIAL HERO (Realistic, Layered & Floated Architecture)
       Structured 2-Column Corporate Layout with Floating Ambient Depth
       ══════════════════════════════════════════════════════════════════════════ -->
  <header class="inner-hero" aria-label="Who we serve introduction">
    <!-- Ambient Floating Lighting Orbs -->
    <div class="hero-ambient-orb hero-ambient-orb--gold" aria-hidden="true"></div>
    <div class="hero-ambient-orb hero-ambient-orb--blue" aria-hidden="true"></div>

    <div class="content-container">
      <!-- Reference-Style Integrated Breadcrumb -->
      <nav class="hero-breadcrumb" aria-label="Breadcrumb navigation">
        <ol class="hero-breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" class="hero-breadcrumb-link" itemprop="item">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li aria-hidden="true" class="hero-breadcrumb-sep">/</li>
          <li class="hero-breadcrumb-current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Who we serve</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>

      <div class="inner-hero-grid">

        <!-- Left Column: Editorial Content & Floating Translucent Card -->
        <div class="inner-hero-content" data-reveal>
          <h1 class="inner-hero-title">
            A channel-led<br />
            distribution <span class="inner-hero-title-accent">strategy</span>
          </h1>

          <p class="inner-hero-subtitle">
            Because a restaurant, a cash-and-carry and an independent retailer are running very different businesses.
          </p>
        </div>

        <!-- Right Column: Realistic Multi-Layered Floating Composition (Image Only) -->
        <div class="inner-hero-showcase" data-reveal>
          <div class="floating-stage-container">
            <!-- Main Sculpted Image Showcase -->
            <div class="hero-sculpted-frame">
              <img
                src="/assets/warehouse-partnership.jpg"
                alt="Kingsway commercial executives in partnership inside modern high-bay logistics warehouse"
                class="hero-showcase-img"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════════════════════════════════
       HIGHLIGHTS & TRUST STRIP (Horizontal Bar Bridging Hero to Channels)
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section-trust-strip" aria-label="Key distribution highlights">
    <div class="content-container">
      <div class="trust-strip">
        <div class="trust-item">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 17l-5-5a3 3 0 0 1 4.24-4.24L12 9.5l1.76-1.74a3 3 0 0 1 4.24 4.24L13 17a2.83 2.83 0 0 1-2 0z"/>
              <path d="M7 11l-2 2a2 2 0 0 0 0 2.83l2 2a2 2 0 0 0 2.83 0l1.17-1.17"/>
              <path d="M17 13l2-2a2 2 0 0 0 0-2.83l-2-2a2 2 0 0 0-2.83 0L13.83 7.34"/>
            </svg>
          </div>
          <div class="trust-text">
            <strong class="trust-title">Trusted Partner,</strong>
            <span class="trust-sub">Across the UK</span>
          </div>
        </div>

        <div class="trust-divider" aria-hidden="true"></div>

        <div class="trust-item">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <div class="trust-text">
            <strong class="trust-title">Efficient Distribution,</strong>
            <span class="trust-sub">Nationwide Logistics</span>
          </div>
        </div>

        <div class="trust-divider" aria-hidden="true"></div>

        <div class="trust-item">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <div class="trust-text">
            <strong class="trust-title">Quality Assured,</strong>
            <span class="trust-sub">Always Verified</span>
          </div>
        </div>

        <div class="trust-divider" aria-hidden="true"></div>

        <div class="trust-item">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
              <polyline points="4 9 12 3 20 7"/>
            </svg>
          </div>
          <div class="trust-text">
            <strong class="trust-title">Growing Together,</strong>
            <span class="trust-sub">Strategic Co-Development</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       MAIN CHANNELS SECTION, 5 Redesigned Non-Rectangular Channels
       ══════════════════════════════════════════════════════════════════════════ -->
  <section id="channels" class="section-channels" aria-label="Channels we serve">
    <div class="content-container">

      <!-- SECTION 1: Independent retail & convenience -->
      <article class="channel-card channel-card--retail" id="channel-retail" data-reveal>
        <div class="channel-text-col">
          <div class="phase-pill-wrap">
            <span class="phase-pill phase-pill--gold">PHASE 1</span>
            <span class="channel-category-label">Active Core Channel</span>
          </div>
          <h2 class="channel-title">Independent retail &amp; convenience</h2>
          <p class="channel-body">
            Independent grocers, specialist ethnic stores and convenience retailers are the backbone of ethnic food distribution in the UK. They demand flexibility, reliability and fair pricing, in that order.
          </p>
          <ul class="luxury-check-list" role="list">
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Flexible pack sizes from single-unit retail to inner-case formats.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Reliable weekly delivery schedules through direct trading relationships and regional distribution partners.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Competitive wholesale pricing, transparent, with no hidden rebates or conditional discounts.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Merchandising and shelf-ready packaging support where required.</span>
            </li>
          </ul>
          <div class="channel-cta-row">
            <a href="/contact?subject=retail" class="channel-action-btn">
              <span>Enquire for Retail</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="channel-visual-col">
          <div class="image-frame frame-organic-retail">
            <img
              src="/assets/retail-store.jpg"
              alt="Independent retail grocery store aisle stocked with spices and pantry goods"
              class="channel-img"
              loading="lazy"
            />
            <div class="image-halo-stroke" aria-hidden="true"></div>
            <!-- Floating Badge matching mockup -->
            <a href="/contact?subject=retail" class="floating-badge-navy">
              <span class="badge-text">Your Trusted Distribution Partner</span>
              <span class="badge-arrow-circle" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </div>
        </div>
      </article>

      <!-- SECTION 2: Cash & carry and wholesale (REVERSED) -->
      <article class="channel-card channel-card--reversed channel-card--wholesale" id="channel-wholesale" data-reveal>
        <div class="channel-visual-col">
          <div class="image-frame frame-organic-wholesale">
            <div class="dot-grid-accent" aria-hidden="true"></div>
            <img
              src="/assets/wholesale-warehouse.jpg"
              alt="Large modern wholesale cash and carry warehouse depot with pallet racking and forklift"
              class="channel-img"
              loading="lazy"
            />
            <div class="image-halo-stroke" aria-hidden="true"></div>
            <button class="center-inspect-btn" aria-label="View warehouse operations" type="button">
              <svg width="16" height="18" viewBox="0 0 10 12" fill="currentColor">
                <path d="M1 1.5L8.5 6L1 10.5V1.5Z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="channel-text-col">
          <div class="phase-pill-wrap">
            <span class="phase-pill phase-pill--gold">PHASE 1</span>
            <span class="channel-category-label">Bulk Wholesale</span>
          </div>
          <h2 class="channel-title">Cash &amp; carry and wholesale</h2>
          <p class="channel-body">
            National and regional cash-and-carry operators need volume, price discipline and a trading partner who respects margin structures. Kingsway will support this channel through:
          </p>
          <ul class="luxury-check-list" role="list">
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Bulk pack formats for high-velocity categories, rice, pulses, oils.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>A promotional calendar developed with buyer input, not imposed on them.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Clear trading terms published in writing, including payment terms and minimum order quantities.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Responsive account management for new listings, promotions and seasonal peaks.</span>
            </li>
          </ul>
          <div class="channel-cta-row">
            <a href="/contact?subject=wholesale" class="channel-action-btn">
              <span>Wholesale Trade Enquiry</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- SECTION 3: Food service -->
      <article class="channel-card channel-card--foodservice" id="channel-foodservice" data-reveal>
        <div class="channel-text-col">
          <div class="phase-pill-wrap">
            <span class="phase-pill phase-pill--gold">PHASE 1</span>
            <span class="channel-category-label">Catering &amp; Hospitality</span>
          </div>
          <h2 class="channel-title">Food service</h2>
          <p class="channel-body">
            Restaurants, caterers and institutional kitchens require catering-pack formats, consistency of supply, and ingredient provenance that can be stood behind. This is a natural fit for a distributor whose sourcing discipline is a visible strength.
          </p>
          <ul class="luxury-check-list" role="list">
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Catering pack formats matched to kitchen needs, not just to warehouse convenience.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Consistency of specification, order-to-order, season-to-season.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Provenance-led category advice for menu development.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
              </span>
              <span>Direct access to a named account owner for every food service customer.</span>
            </li>
          </ul>
          <div class="channel-cta-row">
            <a href="/contact?subject=foodservice" class="channel-action-btn">
              <span>Food Service Partner Enquiry</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="channel-visual-col">
