    background: linear-gradient(180deg, transparent 60%, rgba(11, 28, 54, 0.7) 100%);
    pointer-events: none;
  }

  .private-floating-badge {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: rgba(11, 28, 54, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid var(--gold-border);
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--warm-white);
  }

  .private-badge-gold-spark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
    box-shadow: 0 0 10px var(--gold-light);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     6. HOW TO ORDER ONBOARDING
