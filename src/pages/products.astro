---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/products/ProductCard.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import { mainProductCategories, type ProductCategory, type ProductCategoryGroup } from '../data/product-categories';

// Helper to determine filter group for quick buyer filtering
function getFilterGroup(slug: string): string {
  if (['lentils', 'rice-poha-mamra', 'flour', 'ghee-oil'].includes(slug)) return 'staples';
  if (['spices', 'paste-sauces', 'dunns-river-spices-seasonings'].includes(slug)) return 'spices';
  if (['grace', 'encona-sauces', 'dunns-river-ingredients', 'dunns-river-dried-powders-pulses', 'sunshine-snacks', 'brunswick-sardines', 'dalgety-teas'].includes(slug)) return 'brands';
  if (slug === 'frozen') return 'frozen';
  return 'pantry';
}

// Helper to get product count safely
function getCount(cat: ProductCategory | ProductCategoryGroup): number {
  if ('products' in cat) return cat.products.length;
  if ('categories' in cat) {
    return cat.categories.reduce((acc, c) => acc + (c.products ? c.products.length : 0), 0);
  }
  return 12;
}

const totalCategories = mainProductCategories.length;
---

<BaseLayout
  title="Wholesale Food Products & Range | Kingsway International"
  description="Explore Kingsway International's comprehensive ethnic food wholesale catalogue: pulses, spices, rice, flours, oils, world brands including Grace and Encona, frozen products and private label supply across the UK."
>
  <!-- ══════════════════════════════════════════════════════════════════════════
       HERO SECTION (High-CRO, Integrated Breadcrumb & Wholesale Value Proposition)
       ══════════════════════════════════════════════════════════════════════════ -->
  <header class="products-hero" aria-label="Products introduction">
    <div class="hero-ambient-orb hero-ambient-orb--gold" aria-hidden="true"></div>
    <div class="hero-ambient-orb hero-ambient-orb--blue" aria-hidden="true"></div>

    <div class="content-container">
      <!-- Reference-Style Integrated Breadcrumb -->
      <nav class="hero-breadcrumb" aria-label="Breadcrumb navigation">
        <ol class="hero-breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" class="hero-breadcrumb-link" itemprop="item">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li aria-hidden="true" class="hero-breadcrumb-sep">/</li>
          <li class="hero-breadcrumb-current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Products</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>

      <div class="products-hero-grid">
        <!-- Left Column: Heading and Description Only -->
        <div class="products-hero-content" data-reveal>
          <h1 class="products-hero-title">
            A focused portfolio<br />
            chosen with <span class="title-highlight">purpose</span>
          </h1>

          <p class="products-hero-subtitle">
            Authentic ethnic foods, pulses, spices, flours, edible oils, world brands and catering packs, supplied with nationwide UK reliability from our Leicester central distribution depot.
          </p>
        </div>

        <!-- Right Column: Sculpted Commercial Photography Frame (Image Only) -->
        <div class="products-hero-visual" data-reveal>
          <div class="visual-sculpture-container">
            <img
              src="/images/Productsbanner.jpeg"
              alt="Kingsway International Wholesale Food Portfolio"
              class="hero-visual-img"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════════════════════════════════
       SECOND SECTION: PRODUCT CATEGORIES CATALOGUE (Main Focus of Page)
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="catalogue-section" id="categories" aria-labelledby="catalogue-heading">
    <div class="content-container">
      <!-- Section Header -->
      <div class="catalogue-section-header">
        <div class="header-left">
          <span class="catalogue-kicker">UK WHOLESALE CATALOGUE</span>
          <h2 id="catalogue-heading" class="catalogue-main-title">
            Browse by product category
          </h2>
          <p class="catalogue-subtitle">
            Explore authentic ethnic staples, direct farm-origin spices, premium flours, pure oils, world brands and catering formats imported directly for UK trade buyers.
          </p>
        </div>

        <!-- Quick Catalogue Download Box -->
        <div class="catalogue-download-box">
          <span class="download-box-tag">Wholesale Buyers</span>
          <h3 class="download-box-heading">Need our full commercial price list?</h3>
          <p class="download-box-caption">We supply detailed specifications and tiered volume pricing within 24 hours.</p>
          <a href="/contact?subject=price-list" class="btn-download-trigger">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Request Trade Price Sheet</span>
          </a>
        </div>
      </div>

      <!-- Filter Controls: Search & Category Pills -->
      <div class="filter-toolbar" data-reveal>
        <div class="search-input-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="category-search"
            class="category-search-input"
            placeholder="Search categories, spices, rice, flours, oils, brands..."
            aria-label="Search product categories"
          />
        </div>

        <!-- Filter Pills -->
        <div class="filter-pills-list" role="tablist" aria-label="Filter categories by type">
          <button type="button" class="filter-pill filter-pill--active" data-filter="all" role="tab" aria-selected="true">
            All Categories ({totalCategories})
          </button>
          <button type="button" class="filter-pill" data-filter="staples" role="tab" aria-selected="false">
            Rice &amp; Pulses
          </button>
          <button type="button" class="filter-pill" data-filter="spices" role="tab" aria-selected="false">
            Spices &amp; Seasonings
          </button>
          <button type="button" class="filter-pill" data-filter="brands" role="tab" aria-selected="false">
            World Brands (Grace &amp; More)
          </button>
          <button type="button" class="filter-pill" data-filter="frozen" role="tab" aria-selected="false">
            Frozen Specialties
          </button>
          <button type="button" class="filter-pill" data-filter="pantry" role="tab" aria-selected="false">
            Pantry &amp; Snacks
          </button>
        </div>
      </div>

      <!-- Live Category Results Counter -->
      <div class="catalogue-status-bar">
        <p class="status-count" id="category-status-count">
          Showing <span class="count-num" id="visible-count">{totalCategories}</span> categories in UK distribution
        </p>
      </div>

      <!-- High-CRO Category Cards Grid -->
      <div class="catalogue-grid" id="category-grid">
        {mainProductCategories.map((cat) => {
          const skuCount = getCount(cat);
          const filterGroup = getFilterGroup(cat.slug);
          const isGrace = cat.slug === 'grace';
          const linkHref = isGrace ? '/products/grace/' : `/products/${cat.slug}/`;

          return (
            <ProductCard
              class="category-card"
              name={cat.name}
              image={cat.image}
              description={cat.description}
              href={linkHref}
              enquiryHref={`/contact?subject=${cat.slug}`}
              productCount={skuCount}
              data-group={filterGroup}
              data-slug={cat.slug}
              data-name={cat.name.toLowerCase()}
              data-desc={cat.description.toLowerCase()}
            />
          );
        })}
      </div>

      <!-- Empty Filter State -->
      <div id="no-results-state" class="no-results-state" style="display: none;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
        <h3 class="no-results-title">No matching product categories</h3>
        <p class="no-results-text">We could not find any categories matching your search term. Try a different search or clear your filter.</p>
        <button type="button" id="reset-filter-btn" class="btn-reset-filter">Reset Filters</button>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       WHOLESALE TRUST & SERVICE METRICS STRIP
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="trust-metrics-strip" aria-label="Wholesale supply highlights">
    <div class="content-container">
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div class="metric-details">
            <h3 class="metric-title">Direct Origin Sourcing</h3>
            <p class="metric-text">Direct grower relationships in India, Kerala and worldwide for authentic quality and margin advantage.</p>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <div class="metric-details">
            <h3 class="metric-title">Flexible Order Formats</h3>
            <p class="metric-text">From single-unit retail cases to full mixed pallets and container loads, tailored to your trade rhythm.</p>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <div class="metric-details">
            <h3 class="metric-title">Intake Tested &amp; Certified</h3>
            <p class="metric-text">5-stage laboratory verification on arrival in Leicester for purity, moisture, and full UK food safety compliance.</p>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="metric-details">
            <h3 class="metric-title">Named Account Specialist</h3>
            <p class="metric-text">Direct trade support with prompt answers on stock levels, special orders, and volume tier pricing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       OUR DISCIPLINE: 3-POINT QUALITY FRAMEWORK (Value Proposition & Trust)
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="discipline-section" aria-labelledby="discipline-heading">
    <div class="content-container">
      <div class="discipline-header" data-reveal>
        <span class="discipline-kicker">OUR SOURCING DISCIPLINE</span>
        <h2 id="discipline-heading" class="discipline-title">
          A range built with purpose, not excess
        </h2>
        <p class="discipline-intro">
          Every product line Kingsway International lists must earn its place on your shelves and in your kitchens. We rigorously test each new commercial line against three non-negotiable criteria before distribution:
        </p>
      </div>

      <div class="discipline-cards-grid">
        <div class="discipline-card" data-reveal>
          <div class="discipline-num">01</div>
          <h3 class="discipline-card-heading">Confirmed Customer Demand</h3>
          <p class="discipline-card-text">
            We listen to independent grocery retailers, restaurant chefs and cash &amp; carry buyers. If an ingredient does not have authentic velocity and real consumer appetite in the UK market, we do not list it.
          </p>
          <div class="discipline-tag">Consumer &amp; Chef Led</div>
        </div>

        <div class="discipline-card" data-reveal>
          <div class="discipline-num">02</div>
          <h3 class="discipline-card-heading">Uncompromising Quality Standards</h3>
          <p class="discipline-card-text">
            Can we verify the farm origin, inspect the processing facility, and guarantee unbroken microbiological and phytosanitary compliance? If quality cannot be proven lot by lot, it does not enter our warehouse.
          </p>
          <div class="discipline-tag">Lab-Verified Intake</div>
        </div>

        <div class="discipline-card" data-reveal>
          <div class="discipline-num">03</div>
          <h3 class="discipline-card-heading">Strengthening Range Integrity</h3>
          <p class="discipline-card-text">
            Does the product deliver margin integrity, genuine distinctiveness, and commercial reliability without diluting our category expertise? Lines that fail any of the three are rejected without hesitation.
          </p>
          <div class="discipline-tag">Margin &amp; Brand Focus</div>
        </div>
      </div>

      <div class="discipline-cta-strip" data-reveal>
        <div class="discipline-cta-text">
          <h4 class="discipline-cta-heading">Want to review our full catalogue specifications?</h4>
          <p class="discipline-cta-caption">Request technical data sheets, allergen matrices and commercial volume pricing.</p>
        </div>
        <a href="/contact" class="btn-primary-gold">
          <span>Request Catalogue Pack</span>
          <span class="btn-icon-circle" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       PRIVATE LABEL & OWN-BRAND PROGRAMMES (B2B Growth & Commercial Options)
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="private-label-section" aria-labelledby="private-label-heading">
    <div class="content-container">
      <div class="private-label-grid">
        <div class="private-label-content" data-reveal>
          <span class="private-kicker">COMMERCIAL PARTNERSHIPS</span>
          <h2 id="private-label-heading" class="private-label-title">
            Private label and own-brand programmes
          </h2>
          <p class="private-label-body">
            Kingsway operates an established private-label programme for retail chains, supermarket multiples and large foodservice groups who require the reliability of our global supply chain under their own house brand.
          </p>

          <div class="private-features-list">
            <div class="private-feature-item">
              <div class="feature-icon-bullet" aria-hidden="true">1</div>
              <div class="feature-content">
                <h4 class="feature-title">Custom Packaging &amp; Barcode Compliance</h4>
                <p class="feature-desc">From retail shelf-ready stand-up pouches to catering tubs and heavy-duty 25kg bulk bags, compliant with UK retail labelling standards.</p>
              </div>
            </div>

            <div class="private-feature-item">
              <div class="feature-icon-bullet" aria-hidden="true">2</div>
              <div class="feature-content">
                <h4 class="feature-title">Controlled Sourcing &amp; Consistent Specs</h4>
                <p class="feature-desc">Contracted harvest sourcing guarantees grain length, oil purity, spice colour index and consistency season after season.</p>
              </div>
            </div>

            <div class="private-feature-item">
              <div class="feature-icon-bullet" aria-hidden="true">3</div>
              <div class="feature-content">
                <h4 class="feature-title">Sensible Minimum Order Quantities</h4>
                <p class="feature-desc">Minimum order runs, packaging production and delivery lead times are structured case-by-case to fit your operational scale.</p>
              </div>
            </div>
          </div>

          <div class="private-actions">
            <a href="/contact?subject=private-label" class="btn-primary-gold">
              <span>Enquire About Private Label</span>
              <span class="btn-icon-circle" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            <a href="/who-we-serve#channel-multiples" class="btn-secondary-navy">
              <span>View Multiples Strategy</span>
            </a>
          </div>
        </div>

        <div class="private-label-visual" data-reveal>
          <div class="private-image-card">
            <img
              src="/images/Private.jpeg"
              alt="Private label food manufacturing and packaging"
              class="private-img"
              loading="lazy"
            />
            <div class="private-curved-halo" aria-hidden="true"></div>
            <div class="private-floating-badge">
              <span class="private-badge-gold-spark" aria-hidden="true"></span>
              <span>Bespoke Retail &amp; Foodservice Packaging</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       HOW TO ORDER: 3-STEP TRADE ONBOARDING FUNNEL
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="onboarding-section" aria-labelledby="onboarding-heading">
    <div class="content-container">
      <div class="onboarding-header" data-reveal>
        <span class="onboarding-kicker">FAST COMMERCIAL ONBOARDING</span>
        <h2 id="onboarding-heading" class="onboarding-title">
          How to start trading with Kingsway
        </h2>
        <p class="onboarding-caption">
          Opening a commercial account takes less than 24 hours. Here is how simple it is to get started:
        </p>
      </div>

      <div class="onboarding-steps-grid">
        <div class="onboarding-step-card" data-reveal>
          <div class="step-badge">STEP 01</div>
          <h3 class="step-title">Submit Trade Enquiry</h3>
          <p class="step-text">
            Let us know your business type (retail store, cash &amp; carry, restaurant group or export) and the product categories you are interested in.
          </p>
        </div>

        <div class="onboarding-step-card" data-reveal>
          <div class="step-badge">STEP 02</div>
          <h3 class="step-title">Receive Tiered Price Sheet</h3>
          <p class="step-text">
            Your named account director provides customized wholesale price schedules, volume brackets, sample options and delivery turnaround details.
          </p>
        </div>

        <div class="onboarding-step-card" data-reveal>
          <div class="step-badge">STEP 03</div>
          <h3 class="step-title">Confirm Delivery Drop</h3>
          <p class="step-text">
            Place your opening order with flexible payment terms. Your shipment is consolidated and dispatched directly from our Leicester depot.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       TRADE CTA BANNER
       ══════════════════════════════════════════════════════════════════════════ -->
  <CTABanner
    heading="Start a trade conversation"
    caption="We answer every enquiry within one business day with transparent pricing and clear trading terms."
    buttonLabel="Send an enquiry"
    buttonHref="/contact"
  />
</BaseLayout>

<!-- Client-side Interactive Search & Category Filter Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('category-search');
    const filterPills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.category-card');
    const visibleCountElem = document.getElementById('visible-count');
    const noResultsState = document.getElementById('no-results-state');
    const resetBtn = document.getElementById('reset-filter-btn');

    let currentFilter = 'all';
    let searchQuery = '';

    function filterCategories() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const group = card.getAttribute('data-group') || '';
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchesGroup = (currentFilter === 'all') || (group === currentFilter);
        const matchesSearch = !searchQuery || name.includes(searchQuery) || desc.includes(searchQuery);

        if (matchesGroup && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCountElem) {
        visibleCountElem.textContent = String(visibleCount);
      }

      if (noResultsState) {
        noResultsState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Pill click handler
    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => {
          p.classList.remove('filter-pill--active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('filter-pill--active');
        pill.setAttribute('aria-selected', 'true');

        currentFilter = pill.getAttribute('data-filter') || 'all';
        filterCategories();
      });
    });

    // Search input handler
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        filterCategories();
      });
    }

    // Reset button handler
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentFilter = 'all';

        filterPills.forEach((p, idx) => {
          if (idx === 0) {
            p.classList.add('filter-pill--active');
            p.setAttribute('aria-selected', 'true');
          } else {
            p.classList.remove('filter-pill--active');
            p.setAttribute('aria-selected', 'false');
          }
        });

        filterCategories();
      });
    }
  });
</script>

<style>
  :root {
    --deep-navy: #0B1C36;
    --royal-navy: #173A78;
    --champagne-gold: #D9A441;
    --gold-light: #F4BF4F;
    --gold-soft-bg: rgba(217, 164, 65, 0.12);
    --gold-border: rgba(217, 164, 65, 0.35);
    --warm-white: #FAF9F6;
    --light-beige: #F1EDE5;
    --body-text: #465166;
    --heading-ink: #0B1C36;
    --subtle-rule: #E5E5E5;
  }

  .content-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     1. HERO SECTION (Integrated Breadcrumb & Realistic Floated Layout)
     ══════════════════════════════════════════════════════════════════════════ */
  .products-hero {
    position: relative;
    background: linear-gradient(135deg, #FAF9F6 0%, #FFFFFF 50%, #F5F1E8 100%);
    padding: 2rem 0 4.5rem;
    border-bottom: 1px solid rgba(229, 229, 229, 0.6);
    overflow: hidden;
  }

  .hero-ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
  }

  .hero-ambient-orb--gold {
    top: 5%;
    right: 15%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.18) 0%, transparent 70%);
  }

  .hero-ambient-orb--blue {
    bottom: -10%;
    left: 5%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(23, 58, 120, 0.08) 0%, transparent 70%);
  }

  /* Reference-Style Integrated Breadcrumb */
  .hero-breadcrumb {
    margin-bottom: 2rem;
    position: relative;
    z-index: 5;
  }

  .hero-breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .hero-breadcrumb-link {
    color: var(--body-text);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .hero-breadcrumb-link:hover {
    color: var(--royal-navy);
  }

  .hero-breadcrumb-sep {
    color: rgba(70, 81, 102, 0.45);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .hero-breadcrumb-current {
    color: var(--deep-navy);
    font-weight: 600;
  }

  .products-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4.5rem;
    align-items: center;
  }

  .products-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 4vw, 3.65rem);
    line-height: 1.12;
    font-weight: 400;
    color: var(--deep-navy);
    margin: 0 0 1.25rem;
    letter-spacing: -0.015em;
  }

  .title-highlight {
    font-style: italic;
    color: var(--champagne-gold);
    font-weight: 400;
  }

  .products-hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    line-height: 1.6;
    color: var(--deep-navy);
    font-weight: 600;
    margin: 0 0 1.5rem;
    max-width: 620px;
  }

  .floating-lede-card {
    position: relative;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    border: 1px solid var(--gold-border);
    border-radius: 14px;
    padding: 1.25rem 1.6rem;
    margin-bottom: 2rem;
    box-shadow: 0 10px 25px rgba(11, 28, 54, 0.05);
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
  }

  .lede-accent-bar {
    width: 4px;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--champagne-gold) 0%, var(--gold-light) 100%);
    flex-shrink: 0;
  }

  .floating-lede-text {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--body-text);
    margin: 0;
  }

  /* High-CRO Action Buttons */
  .hero-action-buttons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .btn-primary-gold {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--champagne-gold) 0%, #c9922e 100%);
    color: var(--deep-navy);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.85rem 1.65rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(217, 164, 65, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-primary-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(217, 164, 65, 0.45);
  }

  .btn-icon-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--deep-navy);
    color: var(--champagne-gold);
  }

  .btn-secondary-navy {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    color: var(--royal-navy);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid var(--gold-border);
    transition: all 0.2s ease;
  }

  .btn-secondary-navy:hover {
    background: var(--warm-white);
    border-color: var(--champagne-gold);
    color: var(--deep-navy);
    transform: translateY(-2px);
  }

  /* Trust Badges */
  .hero-trust-badges {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid rgba(229, 229, 229, 0.8);
  }

  .trust-badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--deep-navy);
  }

  .trust-badge-check {
    color: var(--champagne-gold);
    font-weight: 800;
  }

  /* Sculpted Visual Right Column */
  .products-hero-visual {
    position: relative;
  }

  .visual-sculpture-container {
    position: relative;
    border-radius: 36px 120px 36px 90px;
    overflow: hidden;
    box-shadow: 
      0 0 0 1px var(--gold-border),
      0 24px 60px -15px rgba(11, 28, 54, 0.22);
    background-color: var(--deep-navy);
    aspect-ratio: 4 / 3;
    max-height: 480px;
  }

  .hero-visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .visual-sculpture-container:hover .hero-visual-img {
    transform: scale(1.03);
  }

  .visual-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 65%, rgba(11, 28, 54, 0.7) 100%);
    pointer-events: none;
  }

  /* Floating Stat Pills */
  .floating-stat-pill {
    position: absolute;
    background: rgba(11, 28, 54, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid var(--gold-border);
    padding: 0.65rem 1.15rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--warm-white);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .floating-stat-pill--top {
    top: 1.5rem;
    right: 1.5rem;
  }

  .floating-stat-pill--bottom {
    bottom: 1.5rem;
    left: 1.5rem;
  }

  .pill-gold-indicator {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
    box-shadow: 0 0 12px var(--gold-light);
  }

  .pill-icon {
    color: var(--champagne-gold);
  }

  .pill-text-wrap {
    display: flex;
    flex-direction: column;
  }

  .pill-headline {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-subline {
    font-size: 0.6875rem;
    color: rgba(250, 249, 246, 0.75);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     2. TRUST & SERVICE METRICS STRIP
     ══════════════════════════════════════════════════════════════════════════ */
  .trust-metrics-strip {
    background-color: var(--deep-navy);
    color: var(--warm-white);
    padding: 3rem 0;
    border-bottom: 1px solid rgba(217, 164, 65, 0.25);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .metric-card {
    display: flex;
    gap: 1.15rem;
    align-items: flex-start;
  }

  .metric-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(217, 164, 65, 0.12);
    border: 1px solid rgba(217, 164, 65, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--champagne-gold);
    flex-shrink: 0;
  }

  .metric-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0 0 0.35rem;
    color: var(--warm-white);
  }

  .metric-text {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(250, 249, 246, 0.8);
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     3. CATALOGUE SECTION & INTERACTIVE TOOLBAR
     ══════════════════════════════════════════════════════════════════════════ */
  .catalogue-section {
    background-color: var(--warm-white);
    padding: 5rem 0 6rem;
  }

  .catalogue-section-header {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: 3.5rem;
  }

  .catalogue-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champagne-gold);
    display: block;
    margin-bottom: 0.65rem;
  }

  .catalogue-main-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.2;
    color: var(--heading-ink);
    margin: 0 0 1rem;
    font-weight: 500;
  }

  .catalogue-subtitle {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--body-text);
    margin: 0;
    max-width: 620px;
  }

  /* Download Box CTA */
  .catalogue-download-box {
    background: #ffffff;
    border: 1px solid var(--gold-border);
    border-radius: 20px;
    padding: 1.75rem 2rem;
    box-shadow: 0 12px 32px rgba(11, 28, 54, 0.06);
    position: relative;
  }

  .download-box-tag {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--royal-navy);
    background: rgba(23, 58, 120, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 0.65rem;
  }

  .download-box-heading {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--deep-navy);
    margin: 0 0 0.45rem;
  }

  .download-box-caption {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--body-text);
    margin: 0 0 1.25rem;
  }

  .btn-download-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background-color: var(--deep-navy);
    color: var(--warm-white);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.7rem 1.35rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid var(--gold-border);
    transition: all 0.2s ease;
  }

  .btn-download-trigger:hover {
    background-color: var(--royal-navy);
    border-color: var(--champagne-gold);
    color: var(--champagne-gold);
    transform: translateY(-2px);
  }

  /* Filter Toolbar */
  .filter-toolbar {
    background: #ffffff;
    border: 1px solid rgba(217, 164, 65, 0.25);
    border-radius: 18px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 6px 20px rgba(11, 28, 54, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-input-wrap {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: #94A3B8;
  }

  .category-search-input {
    width: 100%;
    padding: 0.85rem 1.25rem 0.85rem 3rem;
    border-radius: 9999px;
    border: 1px solid var(--subtle-rule);
    background-color: var(--warm-white);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--deep-navy);
    outline: none;
    transition: all 0.2s ease;
  }

  .category-search-input:focus {
    border-color: var(--champagne-gold);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(217, 164, 65, 0.15);
  }

  .filter-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .filter-pill {
    background: var(--warm-white);
    border: 1px solid rgba(229, 229, 229, 0.9);
    color: var(--body-text);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.5rem 1.15rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    border-color: var(--champagne-gold);
    color: var(--deep-navy);
  }

  .filter-pill--active {
    background-color: var(--deep-navy);
    color: var(--warm-white);
    border-color: var(--deep-navy);
  }

  .catalogue-status-bar {
    margin-bottom: 2.25rem;
  }

  .status-count {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--body-text);
    margin: 0;
  }

  .count-num {
    font-weight: 800;
    color: var(--deep-navy);
  }

  /* Category Cards Grid */
  .badge-num {
    color: var(--champagne-gold);
    font-weight: 800;
  }

  /* No Results Fallback */
  .no-results-state {
    text-align: center;
    padding: 4rem 2rem;
    background: #ffffff;
    border: 1px dashed var(--gold-border);
    border-radius: 20px;
    margin-top: 2rem;
  }

  .empty-icon {
    color: var(--champagne-gold);
    margin-bottom: 1rem;
  }

  .no-results-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--deep-navy);
    margin: 0 0 0.5rem;
  }

  .no-results-text {
    font-size: 0.9375rem;
    color: var(--body-text);
    margin: 0 0 1.5rem;
  }

  .btn-reset-filter {
    background-color: var(--champagne-gold);
    color: var(--deep-navy);
    border: none;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     4. OUR DISCIPLINE SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .discipline-section {
    background-color: #ffffff;
    padding: 5.5rem 0;
    border-top: 1px solid var(--gold-border);
  }

  .discipline-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .discipline-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champagne-gold);
    display: block;
    margin-bottom: 0.65rem;
  }

  .discipline-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    color: var(--heading-ink);
    margin: 0 0 1.25rem;
    line-height: 1.2;
    font-weight: 500;
  }

  .discipline-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--body-text);
    margin: 0;
  }

  .discipline-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .discipline-card {
    background: var(--warm-white);
    border: 1px solid rgba(217, 164, 65, 0.25);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(11, 28, 54, 0.04);
  }

  .discipline-num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--champagne-gold);
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .discipline-card-heading {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--deep-navy);
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .discipline-card-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--body-text);
    margin: 0 0 1.5rem;
  }

  .discipline-tag {
    margin-top: auto;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--royal-navy);
    background: rgba(23, 58, 120, 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    align-self: flex-start;
  }

  .discipline-cta-strip {
    background: linear-gradient(135deg, var(--deep-navy) 0%, #152b4d 100%);
    border: 1px solid var(--gold-border);
    border-radius: 20px;
    padding: 2.25rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    color: var(--warm-white);
    box-shadow: 0 16px 40px rgba(11, 28, 54, 0.15);
  }

  .discipline-cta-heading {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--warm-white);
    margin: 0 0 0.45rem;
  }

  .discipline-cta-caption {
    font-size: 0.9375rem;
    color: rgba(250, 249, 246, 0.85);
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     5. PRIVATE LABEL & OWN-BRAND SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .private-label-section {
    background-color: var(--warm-white);
    padding: 5.5rem 0;
    border-top: 1px solid var(--gold-border);
  }

  .private-label-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4.5rem;
    align-items: center;
  }

  .private-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champagne-gold);
    display: block;
    margin-bottom: 0.65rem;
  }

  .private-label-title {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 3.2vw, 2.75rem);
    color: var(--heading-ink);
    margin: 0 0 1.25rem;
    line-height: 1.2;
    font-weight: 500;
  }

  .private-label-body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--body-text);
    margin: 0 0 2rem;
  }

  .private-features-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    margin-bottom: 2.25rem;
  }

  .private-feature-item {
    display: flex;
    gap: 1.15rem;
    align-items: flex-start;
  }

  .feature-icon-bullet {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(217, 164, 65, 0.15);
    border: 1px solid var(--gold-border);
    color: var(--deep-navy);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.9375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--deep-navy);
    margin: 0 0 0.25rem;
  }

  .feature-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--body-text);
    margin: 0;
  }

  .private-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .private-label-visual {
    position: relative;
  }

  .private-image-card {
    position: relative;
    border-radius: 36px 90px 36px 120px;
    overflow: hidden;
    box-shadow: 
      0 0 0 1px var(--gold-border),
      0 24px 60px -15px rgba(11, 28, 54, 0.2);
