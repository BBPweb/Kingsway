
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Lede from '../components/ui/Lede.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import Button from '../components/ui/Button.astro';

const categories = [
  {
    name: 'Rice',
    body: 'Basmati, Sella, Parboiled, Sona Masoori, Jasmine and long-grain white rice. Available in retail, wholesale and catering pack formats.',
    image: '/images/Rice.jpeg',
    href: '/products/rice-poha-mamra/'
  },
  {
    name: 'Whole Spices',
    body: 'Cumin, coriander, black pepper, cardamom, cloves, mustard and fenugreek — among others. Sourced at origin, milled and packed to specification.',
    image: '/images/Spiceswhole.jpeg',
    href: '#'
  },
  {
    name: 'Ground Spices',
    body: 'Turmeric, chilli, garam masala, curry powder and a range of regional blends. Retail and foodservice formats.',
    image: '/images/Spicesground.jpeg',
    href: '#'
  },
  {
    name: 'Pulses & lentils',
    body: 'Toor dal, urad, moong, chana, masoor, kidney beans and chickpeas. Staple dals in retail and wholesale pack formats.',
    image: '/images/Pulseslentilsjpeg.jpeg',
    href: '#'
  },
  {
    name: 'Flours & grains',
    body: 'Atta, chapati flour, besan (gram flour), semolina and maize meal. Retail and foodservice formats.',
    image: '/images/Floursgrains.jpeg',
    href: '#'
  },
  {
    name: 'Edible oils & ghee',
    body: 'Sunflower, groundnut, mustard and coconut oils; ghee and clarified butter. Retail and catering pack formats.',
    image: '/images/Edibleoilsghee.jpeg',
    href: '#'
  },
  {
    name: 'Ready-to-use',
    body: 'Pickles, chutneys, cooking pastes, sauces, papads and shelf-stable snacks. Retail formats.',
    image: '/images/Ready.jpeg',
    href: '#'
  },
  {
    name: 'Ethnic grocery',
    body: 'Teas, beverages and canned goods. A frozen range is planned in Phase 2.',
    image: '/images/Ethnicgroceryjpeg.jpeg',
    href: '#'
  },
];
---

<BaseLayout
  title="Products | Spices, Rice, Pulses & Ethnic Grocery | Kingsway International"
  description="Kingsway International's launch portfolio — rice, spices, pulses, edible oils and ethnic grocery staples for UK retail, wholesale and foodservice trade."
>
  <Hero
    eyebrow="Our portfolio"
    title={"A focused portfolio\nChosen with purpose"}
    subtitle="Eight core categories, chosen because they sell consistently and can be sourced well."
    backgroundImage="/images/Productsbanner.jpeg"
  />

  <!-- Intro -->
  <section
    class="section section--white section--narrow"
    aria-label="Products introduction"
  >
    <div class="container container--narrow">
      <Lede>
        Our launch portfolio focuses on categories with deep, consistent demand
        across the UK ethnic food market. We would rather carry a focused
        catalogue of authentic, high-quality lines that move consistently than
        a wide catalogue of marginal ones. The portfolio will be expanded on
        the basis of customer demand and verified supply, not speculative listing.
      </Lede>
    </div>
  </section>

  <!-- Categories -->
  <section
    class="section section--tint"
    aria-labelledby="categories-heading"
  >
    <div class="container">
      <div class="section-head">
        <Eyebrow>Categories</Eyebrow>
        <SectionTitle id="categories-heading">
          Our launch categories
        </SectionTitle>
      </div>

      <div class="grid grid--4">
        {categories.map((cat) => (
          <a
            class="category-card"
            href={cat.href}
            aria-label={`View ${cat.name} products`}
          >
            <img
              src={cat.image}
              alt={cat.name}
              class="category-card-image"
            />

            <div class="category-card-body">
              <h3 class="category-card-title">{cat.name}</h3>

              <p class="category-card-text">
                {cat.body}
              </p>

              {cat.name === 'Rice' && (
                <span class="category-card-link">
                  View products →
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfolio philosophy -->
  <section
    class="section section--white section--narrow"
    aria-labelledby="philosophy-heading"
  >
    <div class="container container--narrow">
      <Eyebrow>Our discipline</Eyebrow>

      <SectionTitle id="philosophy-heading">
        A range with purpose, not excess
      </SectionTitle>

      <div class="prose">
        <p>
          Every SKU Kingsway lists has earned its place. We evaluate new lines
          against three tests:
        </p>

        <ul>
          <li>
            <strong>Is there confirmed customer demand?</strong>
          </li>

          <li>
            <strong>Can we source the product to our quality standard?</strong>
          </li>

          <li>
            <strong>Does it strengthen the range rather than dilute it?</strong>
          </li>
        </ul>

        <p>
          Lines that fail any of the three are not listed, however commercially
          tempting they might look in isolation.
        </p>

        <div class="cta-row">
          <Button
            href="/contact"
            variant="primary"
            size="sm"
            withArrow
          >
            Request a catalogue
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Private label -->
  <section
    class="section section--tint"
    aria-labelledby="private-label-heading"
  >
    <div class="container">
      <div class="two-col">
        <div class="two-col-text">
          <Eyebrow>Private label</Eyebrow>

          <SectionTitle id="private-label-heading">
            Private label and own-brand programmes
          </SectionTitle>

          <div class="prose">
            <p>
              Kingsway operates a private-label programme for retail and
              foodservice customers who want the quality of our supply chain
              under their own brand. Minimum order quantities, packaging options
              and lead times are agreed case-by-case.
            </p>
          </div>

          <div class="cta-row">
            <Button
              href="/contact"
              variant="primary"
              size="md"
              withArrow
            >
              Enquire about private label
            </Button>
          </div>
        </div>

        <div class="two-col-image">
          <img
            src="/images/Private.jpeg"
            alt="Private label packaging"
            class="private-label-image"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Section primitives ── */

  .section {
    padding: 5rem 0;
  }

  .section--white {
    background-color: #ffffff;
  }

  .section--tint {
    background-color: var(--light-tint);
  }

  .section--narrow {
    padding: 4rem 0 3rem;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container--narrow {
    max-width: 880px;
  }

  .section-head {
    max-width: 880px;
    margin-bottom: 3rem;
  }

  /* ── Text ── */

  .prose p {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
    max-width: 700px;
  }

  .prose strong {
    color: var(--primary);
    font-weight: 600;
  }

  .prose ul {
    max-width: 700px;
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .cta-row {
    margin-top: 2rem;
  }

  /* ── Two column ── */

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .two-col-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 880px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ── Grids ── */

  .grid {
    display: grid;
    gap: 2rem;
  }

  .grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 1080px) {
    .grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid--2,
    .grid--4 {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 3.5rem 0;
    }
  }

  /* ── Category card ── */

  .category-card {
    background: #ffffff;
    display: flex;
    text-decoration: none;
    color: inherit;
    flex-direction: column;
    border: 1px solid var(--rule);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(8, 44, 34, 0.06);
  }

  .category-card-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .category-card-body {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .category-card-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.25;
    color: var(--primary);
    margin: 0 0 0.625rem;
  }

  .category-card-text {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--grey);
    margin: 0;
  }

  .category-card-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.04em;
  }

  @media (max-width: 560px) {
    .container {
      padding: 0 1.25rem;
    }
  }
</style>
