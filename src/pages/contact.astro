---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/EditorialHero.astro';
import '../styles/editorial-pages.css';
import Lede from '../components/ui/Lede.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import LocalBusinessSchema from '../components/schema/LocalBusinessSchema.astro';

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_CONTACT ?? '';

const subjectOptions = [
  { value: 'retail',      label: 'Trade enquiry — retail' },
  { value: 'wholesale',   label: 'Trade enquiry — wholesale / cash & carry' },
  { value: 'foodservice', label: 'Trade enquiry — foodservice' },
  { value: 'multiples',   label: 'Trade enquiry — multiples (Phase 2 planning)' },
  { value: 'supplier',    label: 'Become a supplier' },
  { value: 'quality',     label: 'Quality matter or concern' },
  { value: 'press',       label: 'Press or media enquiry' },
  { value: 'careers',     label: 'Careers' },
  { value: 'other',       label: 'Something else' },
];

const directContacts = [
  { label: 'General enquiries',         email: 'info@kingswayinternational.co.uk' },
  { label: 'Commercial and sales',      email: 'sales@kingswayinternational.co.uk' },
  { label: 'Procurement and sourcing',  email: 'sourcing@kingswayinternational.co.uk' },
  { label: 'Quality and compliance',    email: 'quality@kingswayinternational.co.uk' },
  { label: 'Press and media',           email: 'press@kingswayinternational.co.uk' },
  { label: 'Careers',                   email: 'careers@kingswayinternational.co.uk' },
];
---

<BaseLayout
  bodyClass="editorial-page"
  title="Contact Kingsway International | Trade, Supplier & Press Enquiries"
  description="Contact Kingsway International, routed enquiry form for trade buyers, suppliers, press and careers, plus direct email, telephone and postal contact details."
>
  <LocalBusinessSchema slot="head" />

  <Hero
    breadcrumb="Contact"
    highlight="a conversation"
    eyebrow="Contact"
    showEyebrow={false}
    title="Let's start a conversation"
    subtitle="Trade buyer, supplier, journalist or candidate, tell us what you need and we'll route you correctly."
    backgroundImage="/images/contact.jpeg" 
  />

  <!-- Intro -->
  <section class="section section--white section--narrow" aria-label="Contact introduction">
    <div class="container container--narrow">
      <Lede>
        There are different conversations to have, and Kingsway is set up to
        have each of them well. Use the form below, the routing dropdown
        will get your enquiry to the right inbox, or contact the relevant
        function directly. We acknowledge every enquiry within one business day,
        and we send a substantive response within three.
      </Lede>
    </div>
  </section>

  <!-- Form + sidebar -->
  <section class="section section--white" aria-labelledby="form-heading">
    <div class="container">
      <div class="form-layout">
        <!-- Form column -->
        <div class="form-col">
          <h2 id="form-heading" class="form-heading">Enquiry form</h2>

          <form
            id="contact-form"
            action={formspreeEndpoint}
            method="POST"
            novalidate
            data-endpoint={formspreeEndpoint}
          >
            <div class="form-grid">
              <div class="field">
                <label for="name">
                  Your full name <span class="required" aria-hidden="true">*</span>
                </label>
                <input id="name" name="name" type="text" required autocomplete="name" />
              </div>

              <div class="field">
                <label for="email">
                  Your email address <span class="required" aria-hidden="true">*</span>
                </label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>

              <div class="field">
                <label for="company">Your company</label>
                <input id="company" name="company" type="text" autocomplete="organization" />
              </div>

              <div class="field">
                <label for="country">
                  Your country <span class="required" aria-hidden="true">*</span>
                </label>
                <input id="country" name="country" type="text" required autocomplete="country-name" />
              </div>

              <div class="field">
                <label for="telephone">Your telephone number</label>
                <input id="telephone" name="telephone" type="tel" autocomplete="tel" />
              </div>

              <div class="field">
                <label for="subject">
                  What is this about? <span class="required" aria-hidden="true">*</span>
                </label>
                <select id="subject" name="subject" required>
                  <option value="" disabled selected>Choose one&hellip;</option>
                  {subjectOptions.map(opt => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
              </div>

              <div class="field field--full">
                <label for="message">
                  Your message <span class="required" aria-hidden="true">*</span>
                </label>
                <textarea id="message" name="message" rows="6" required></textarea>
              </div>

              <div class="field field--full field--consent">
                <label class="consent-label">
                  <input type="checkbox" name="consent" required />
                  <span>
                    I agree to Kingsway International&rsquo;s
                    <a href="/privacy-notice" class="inline-link">Privacy Notice</a>.
                  </span>
                </label>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="form-submit" id="form-submit">
                <span class="form-submit-label">Send enquiry</span>
              </button>
            </div>

            <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          </form>

          <div id="form-success" class="form-success" hidden role="status">
            <p class="form-success-eyebrow">Thank you</p>
            <p class="form-success-body">
              Your enquiry has reached the right team at Kingsway. We acknowledge
              every enquiry within one business day &mdash; you&rsquo;ll hear from
              us shortly.
            </p>
          </div>

          
        </div>

        <!-- Sidebar -->
        <aside class="sidebar" aria-label="Direct contact details">
          <div class="sidebar-panel">
            <Eyebrow>Direct contact</Eyebrow>

            <h3 class="sidebar-heading">By email</h3>
            <ul class="sidebar-list" role="list">
              {directContacts.map(c => (
                <li class="sidebar-item">
                  <p class="sidebar-item-label">{c.label}</p>
                  <a href={`mailto:${c.email}`} class="sidebar-item-value">{c.email}</a>
                </li>
              ))}
            </ul>

            <h3 class="sidebar-heading sidebar-heading--space">By telephone</h3>
            <p class="sidebar-text">
              +447448938608<br />
            </p>

            <h3 class="sidebar-heading sidebar-heading--space">By post</h3>
            <p class="sidebar-text">
              Kingsway International Ltd<br />
              Unit 1, 75 Hastings Road, <br />
              Leicester.<br />
              
            </p>
          </div>

          <div class="sidebar-callout">
            <Eyebrow>Our response commitment</Eyebrow>
            <p class="sidebar-callout-body">
              Every enquiry is acknowledged within one business day. A substantive
              response follows within three business days &mdash; and if a matter
              is going to take longer than that to resolve, we tell you so, with
              a clear expected timescale.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Office location map -->
  <section class="section section--white map-section" aria-label="Office location map">
    <div class="container">
      <div class="map-placeholder">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2420.891203022769!2d-1.1010023!3d52.64387860000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487761a76d430c17%3A0x73a96619787379ff!2sKingsway%20Cash%20%26%20Carry!5e0!3m2!1sen!2sin!4v1786430349246!5m2!1sen!2sin"
      title="Kingsway Cash & Carry office location"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
      </div>
    </div>
  </section>

  <!-- Two sub-page CTA tiles -->
  <section class="section section--white" aria-label="More ways to get in touch">
    <div class="container">
      <div class="tile-grid">
        <a href="/contact/become-a-supplier" class="cta-tile cta-tile--dark">
          <div class="cta-tile-copy">
          <Eyebrow>For suppliers</Eyebrow>
          <h3 class="cta-tile-title">Become a supplier</h3>
          <p class="cta-tile-body">
            A dedicated path for origin producers, primary processors and
            service providers.
          </p>
          <span class="cta-tile-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
        <a href="/contact/trade-enquiries" class="cta-tile cta-tile--primary">
          <div class="cta-tile-copy">
          <Eyebrow>For trade buyers</Eyebrow>
          <h3 class="cta-tile-title">Trade enquiries</h3>
          <p class="cta-tile-body">
            A dedicated path for retail, wholesale and foodservice buyers.
          </p>
          <span class="cta-tile-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form    = document.getElementById('contact-form');
    var status  = document.getElementById('form-status');
    var submit  = document.getElementById('form-submit');
    var success = document.getElementById('form-success');
    var subject = document.getElementById('subject');

    if (!form || !status || !submit || !success || !subject) return;

    // Pre-select dropdown from URL ?subject=...
    // Trade Enquiries panel slugs map to the same dropdown values.
    var aliasMap = {
      sample:       'retail',
      listing:      'wholesale',
      privatelabel: 'wholesale',
      export:       'wholesale',
    };

    var raw = new URLSearchParams(window.location.search).get('subject');
    if (raw) {
      var target = aliasMap[raw] || raw;
      var matched = false;
      for (var i = 0; i < subject.options.length; i++) {
        if (subject.options[i].value === target) {
          subject.selectedIndex = i;
          matched = true;
          break;
        }
      }
      if (!matched) {
        // Fall back to "Something else" if alias unknown
        for (var j = 0; j < subject.options.length; j++) {
          if (subject.options[j].value === 'other') {
            subject.selectedIndex = j;
            break;
          }
        }
      }
    }

    var endpoint = form.getAttribute('data-endpoint');

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      if (!endpoint) {
        status.textContent = 'Form is not configured. Set PUBLIC_FORMSPREE_CONTACT in .env to enable submissions.';
        status.className = 'form-status form-status--error';
        return;
      }

      // Build JSON payload from form fields
      var data = new FormData(form);
      var payload = {};
      data.forEach(function (value, key) { payload[key] = value; });

      // Loading state
      submit.disabled = true;
      var labelEl = submit.querySelector('.form-submit-label');
      var originalLabel = labelEl ? labelEl.textContent : 'Send enquiry';
      if (labelEl) labelEl.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'form-status';

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (response) {
          if (response.ok) {
            form.hidden = true;
            success.hidden = false;
            success.focus && success.focus();
          } else {
            return response.json().then(function (err) {
              throw new Error(err && err.error ? err.error : 'Network error');
            }).catch(function () {
              throw new Error('We could not send your enquiry. Please try again or email info@kingswayinternational.co.uk.');
            });
          }
        })
        .catch(function (err) {
          status.textContent = err.message || 'Something went wrong. Please try again or email info@kingswayinternational.co.uk.';
          status.className = 'form-status form-status--error';
        })
        .then(function () {
          submit.disabled = false;
          if (labelEl) labelEl.textContent = originalLabel;
        });
    });
  })();
</script>

<style>
.form-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .form-col {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #FFFFFF;
    border: 1px solid var(--rule);
    border-radius: 20px;
    box-shadow: 0 16px 36px -10px rgba(11, 28, 54, 0.08);
  }
  .form-heading { padding-bottom: 1.5rem; border-bottom: 1px solid var(--rule); }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .field { display: flex; flex-direction: column; min-width: 0; }
  .field--full { grid-column: 1 / -1; }
  .field label { font-size: 0.8125rem; font-weight: 700; color: var(--primary); margin-bottom: 0.5rem; }
  .required { color: #946A22; margin-left: 0.15rem; }
  .field input:not([type="checkbox"]), .field select, .field textarea {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 0.85rem 1rem;
    border: 1px solid #DDE1E7;
    border-radius: 10px;
    background: #FAF9F6;
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field select { padding-right: 1.75rem; }
  .field textarea { min-height: 170px; resize: vertical; line-height: 1.7; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(23, 58, 120, 0.08);
  }
  .field--consent .consent-label { display: flex; align-items: flex-start; gap: 0.75rem; font-weight: 500; line-height: 1.65; }
  .consent-label input { width: 18px; height: 18px; margin-top: 0.2rem; flex-shrink: 0; accent-color: var(--primary-dark); }
  .form-actions { margin-top: 1.75rem; }
  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 2rem;
    border: 1px solid var(--primary);
    border-radius: 999px;
    background: var(--primary);
    color: #FAF9F6;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .form-submit:hover:not(:disabled) { background: var(--primary-dark); }
  .form-submit:disabled { opacity: 0.6; cursor: wait; }
  .form-status { margin-top: 1.5rem; padding: 1rem; border-radius: 10px; font-size: 0.875rem; line-height: 1.65; }
  .form-status:empty { display: none; }
  .form-status--error { color: #8A2424; background: #FCF2F2; border-left: 3px solid #B03C3C; }
  .form-success { padding: 2rem; background: #F4F1E8; border: 1px solid var(--editorial-gold-border); border-radius: 16px; }
  .form-success-eyebrow { color: var(--primary-dark); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.18em; margin-bottom: 1rem; }
  .form-success-body { font-family: var(--font-serif); color: var(--primary); font-size: 1.25rem; line-height: 1.6; }
  .sidebar { display: grid; gap: 1.5rem; min-width: 0; }
  .sidebar-panel { padding: 2rem; background: #FFFFFF; border: 1px solid var(--rule); border-radius: 20px; box-shadow: 0 8px 24px -4px rgba(11, 28, 54, 0.04); }
  .sidebar-heading { font-family: var(--font-serif); color: var(--primary); font-size: 1.35rem; font-weight: 500; margin: 0 0 1.25rem; }
  .sidebar-heading--space { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .sidebar-list { display: grid; gap: 1rem; padding: 0; margin: 0; list-style: none; }
  .sidebar-item-label { margin: 0 0 0.3rem; color: var(--grey); font-size: 0.75rem; }
  .sidebar-item-value { color: var(--primary-dark); font-size: 0.875rem; font-weight: 600; overflow-wrap: anywhere; text-decoration: none; }
  .sidebar-item-value:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sidebar-text { font-size: 0.9375rem; line-height: 1.8; color: var(--ink-soft); }
  .sidebar-callout {
    padding: 2rem;
    border: 1px solid var(--editorial-gold-border);
    border-radius: 20px;
    background: radial-gradient(ellipse at top right, rgba(217, 164, 65, 0.16), transparent 70%), #0B1C36;
  }
  .sidebar .sidebar-callout :global(.eyebrow) { color: #F4BF4F; }
  .sidebar-callout-body { font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.7; color: #FAF9F6; }
  .map-section { padding-top: 1rem !important; }
  .map-placeholder { width: 100%; aspect-ratio: 21 / 9; min-height: 320px; overflow: hidden; border-radius: 20px; border: 1px solid var(--rule); background: #F1EDE5; }
  .map-placeholder iframe { display: block; width: 100%; height: 100%; min-height: 320px; border: 0; }
  .tile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .cta-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 20px;
    background: #FFFFFF;
    box-shadow: 0 8px 24px -4px rgba(11, 28, 54, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .cta-tile::before { content: ''; display: block; aspect-ratio: 16 / 7; background-position: center; background-size: cover; }
  .cta-tile--dark::before { background-image: url("/images/contactpart1.jpeg"); }
  .cta-tile--primary::before { background-image: url("/images/contactpart2.jpeg"); }
  .cta-tile:hover { transform: translateY(-4px); box-shadow: 0 20px 36px -8px rgba(11, 28, 54, 0.14); }
  .cta-tile-copy { display: flex; flex-direction: column; flex: 1; padding: 2rem; }
  .cta-tile-title { font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500; line-height: 1.25; color: var(--primary); margin: 0 0 1rem; }
  .cta-tile-body { font-size: 0.9375rem; line-height: 1.7; color: var(--ink-soft); margin: 0 0 1.5rem; flex: 1; }
  .cta-tile-arrow { display: flex; align-items: center; justify-content: flex-end; min-height: 44px; padding-top: 1rem; border-top: 1px solid var(--rule); font-size: 1.5rem; color: var(--primary-dark); }
  @media (max-width: 960px) {
    .form-layout { grid-template-columns: 1fr; }
    .sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }
  @media (max-width: 720px) {
    .form-grid, .sidebar, .tile-grid { grid-template-columns: 1fr; }
    .sidebar-panel, .sidebar-callout, .cta-tile-copy { padding: 1.5rem; }
    .form-submit { width: 100%; }
    .map-placeholder { aspect-ratio: 4 / 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-tile { transition: none; }
    .cta-tile:hover { transform: none; }
  }
</style>
