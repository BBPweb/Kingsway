---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/sections/Hero.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import SectionTitle from '../../../components/ui/SectionTitle.astro';
import GraceBreadcrumbs from '../../../components/products/GraceBreadcrumbs.astro';
import { graceProducts } from '../../../data/product-categories';
---
<BaseLayout title="Grace Products | Kingsway International" description={graceProducts.description}>
  <Hero eyebrow="Our portfolio" title={"Grace Products\nOur range"}
    subtitle={graceProducts.description} backgroundImage={graceProducts.image} />
  <section class="section section--white section--narrow">
    <div class="container container--narrow">
      <GraceBreadcrumbs />
      <p class="prose">{graceProducts.description}</p>
    </div>
  </section>
  <section
    class="section section--tint"
    aria-labelledby="categories-heading"
  >
    <div class="container">
      <div class="section-head">
        <Eyebrow>Categories</Eyebrow>
        <SectionTitle id="categories-heading">
          Browse our Grace product categories
        </SectionTitle>
      </div>

      <div class="grid grid--4">
        {graceProducts.categories.map((cat) => (
          <a
            class="category-card"
            href={`/products/grace/${cat.slug}/`}
            aria-label={`View ${cat.name} products`}
          >
            <img
              src={cat.image}
              alt={cat.name}
              class="category-card-image"
              loading="lazy"
            />

            <div class="category-card-body">
              <h3 class="category-card-title">{cat.name}</h3>

              <p class="category-card-text">
                {cat.description}
              </p>

              <span class="category-card-link">
                View products →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
<style>
  .section {
    padding: 5rem 0;
  }

  .section--white {
    background-color: #ffffff;
  }

  .section--tint {
    background-color: var(--light-tint);
  }

  .section--narrow {
    padding: 4rem 0 3rem;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container--narrow {
    max-width: 880px;
  }

  .section-head {
    max-width: 880px;
    margin-bottom: 3rem;
  }

  .prose {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
    max-width: 700px;
  }

  .prose strong {
    color: var(--primary);
    font-weight: 600;
  }

  .prose ul {
    max-width: 700px;
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .cta-row {
    margin-top: 2rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .two-col-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .grid {
    display: grid;
    gap: 2rem;
  }

  .grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .category-card {
    background: #ffffff;
    display: flex;
    text-decoration: none;
    color: inherit;
    flex-direction: column;
    border: 1px solid var(--rule);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(8, 44, 34, 0.06);
  }

  .category-card-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .category-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .category-card-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.25;
    color: var(--primary);
    margin: 0 0 0.625rem;
  }

  .category-card-text {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--grey);
    margin: 0;
  }

  .category-card-link {
    display: inline-block;
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.04em;
  }

  @media (max-width: 1080px) {
    .grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 880px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 560px) {
    .grid--4 {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 3.5rem 0;
    }

    .container {
      padding: 0 1.25rem;
    }
  }
</style>
