---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Button from '../../components/ui/Button.astro';

const products = [
  {
    name: 'MEDIUM POWA',
    body: '1KG X 6',
    image: '/images/Rice.jpeg',
  },
  {
    name: 'THICK POWA',
    body: '1KG X 6',
    image: '/images/Rice.jpeg',
  },
  {
    name: 'MAKAI POWA',
    body: '15KG',
    image: '/images/Rice.jpeg',
  },
  {
    name: 'KANAIYA MAMRA',
    body: '500G X 20',
    image: '/images/Rice.jpeg',
  },
  {
    name: 'KINGSWAY PHOOL MAKANA',
    body: '100G X 6',
    image: '/images/Rice.jpeg',
  },
];
---

<BaseLayout
  title="Rice | Poha | Mamra | Kingsway International"
  description="Explore the Kingsway International Rice, Poha and Mamra product range."
>
  <Hero
    eyebrow="Rice | Poha | Mamra"
    title={"Rice, Poha & Mamra\nOur products"}
    subtitle="A focused range of products within the Rice, Poha and Mamra category."
    backgroundImage="/images/Rice.jpeg"
  />

  <section
    class="section section--white intro-section"
    aria-labelledby="category-title"
  >
    <div class="container container--narrow">
      <Eyebrow>Category range</Eyebrow>

      <SectionTitle id="category-title">
        RICE | POHA | MAMRA
      </SectionTitle>

      <p class="intro-copy">
        Explore our selected range of Powa, Mamra and Phool Makana products,
        available for retail, wholesale and foodservice requirements.
      </p>
    </div>
  </section>

  <section
    class="section section--tint"
    aria-labelledby="products-heading"
  >
    <div class="container">
      <div class="section-head">
        <Eyebrow>Our products</Eyebrow>

        <SectionTitle id="products-heading">
          Products in this category
        </SectionTitle>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card">
            <img
              src={product.image}
              alt={product.name}
              class="product-card-image"
              loading="lazy"
            />

            <div class="product-card-body">
              <h3 class="product-card-title">{product.name}</h3>

              <p class="product-card-text">
                {product.body}
              </p>

              <a
                class="product-card-link"
                href="/contact"
                aria-label={'Enquire about ' + product.name}
              >
                Trade enquiry →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="enquiry-panel">
        <div>
          <Eyebrow>Trade enquiries</Eyebrow>

          <h2>
            Looking for pack sizes or product specifications?
          </h2>

          <p>
            Contact Kingsway International for product availability,
            specifications, pack formats and trade enquiries.
          </p>
        </div>

        <Button
          href="/contact"
          variant="primary"
          size="md"
          withArrow
        >
          Start a trade conversation
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 5rem 0;
  }

  .section--white {
    background: #ffffff;
  }

  .section--tint {
    background: var(--light-tint);
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container--narrow {
    max-width: 880px;
  }

  .intro-section {
    padding-bottom: 4rem;
  }

  .intro-copy {
    max-width: 760px;
    margin: 1.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .section-head {
    max-width: 880px;
    margin-bottom: 3rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .product-card {
    min-width: 0;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(8, 44, 34, 0.06);
  }

  .product-card-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .product-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .product-card-title {
    margin: 0 0 0.625rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.25;
    color: var(--primary);
  }

  .product-card-text {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--grey);
  }

  .product-card-link {
    display: inline-block;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .product-card-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .enquiry-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 3rem;
    background: var(--light-tint);
    border-top: 3px solid var(--accent);
  }

  .enquiry-panel h2 {
    max-width: 680px;
    margin: 0.5rem 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--primary);
  }

  .enquiry-panel p {
    max-width: 650px;
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    line-height: 1.65;
  }

  @media (max-width: 1080px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .enquiry-panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .section {
      padding: 3.5rem 0;
    }

    .container {
      padding: 0 1.25rem;
    }

    .product-grid {
      grid-template-columns: 1fr;
    }

    .enquiry-panel {
      padding: 2rem 1.5rem;
    }
  }
</style>
