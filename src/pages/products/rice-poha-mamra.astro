import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Button from '../../components/ui/Button.astro';

const products = [
  {
    name: 'MEDIUM POWA',
  },
  {
    name: 'THICK POWA',
  },
  {
    name: 'MAKAI POWA',
  },
  {
    name: 'KANAIYA MAMRA',
  },
  {
    name: 'KINGSWAY PHOOL MAKANA',
  },
];
---

<BaseLayout
  title="Rice | Poha | Mamra | Kingsway International"
  description="Explore the Kingsway International Rice, Poha and Mamra product range."
>
  <Hero
    eyebrow="Rice | Poha | Mamra"
    title={"Rice, Poha & Mamra\nOur products"}
    subtitle="A focused range of products within the Rice, Poha and Mamra category."
    backgroundImage="/images/Rice.jpeg"
  />

  <!-- Category introduction -->
  <section
    class="section section--white intro-section"
    aria-labelledby="category-title"
  >
    <div class="container container--narrow">
      <Eyebrow>Category range</Eyebrow>

      <SectionTitle id="category-title">
        RICE | POHA | MAMRA
      </SectionTitle>

      <p class="intro-copy">
        Explore our selected range of Poha, Mamra and Phool Makana products,
        available for retail, wholesale and foodservice requirements.
      </p>
    </div>
  </section>

  <!-- Products -->
  <section
    class="section section--tint"
    aria-labelledby="products-heading"
  >
    <div class="container">
      <div class="section-head">
        <Eyebrow>Our products</Eyebrow>

        <SectionTitle id="products-heading">
          Products in this category
        </SectionTitle>
      </div>

      <div class="product-list">
        {products.map((product, index) => (
          <article class="product-row">
            <div class="product-number">
              {String(index + 1).padStart(2, '0')}
            </div>

            <div class="product-name">
              <h3>{product.name}</h3>
            </div>

            <div class="product-action">
              <span>Trade enquiry →</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Trade enquiry -->
  <section class="section section--white">
    <div class="container">
      <div class="enquiry-panel">
        <div>
          <Eyebrow>Trade enquiries</Eyebrow>

          <h2>
            Looking for pack sizes or product specifications?
          </h2>

          <p>
            Contact Kingsway International for product availability,
            specifications, pack formats and trade enquiries.
          </p>
        </div>

        <Button
          href="/contact"
          variant="primary"
          size="md"
          withArrow
        >
          Start a trade conversation
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Sections ── */

  .section {
    padding: 5rem 0;
  }

  .section--white {
    background: #ffffff;
  }

  .section--tint {
    background: var(--light-tint);
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container--narrow {
    max-width: 880px;
  }

  .intro-section {
    padding-bottom: 4rem;
  }

  /* ── Introduction ── */

  .intro-copy {
    max-width: 760px;
    margin: 1.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  /* ── Section heading ── */

  .section-head {
    max-width: 880px;
    margin-bottom: 3rem;
  }

  /* ── Product list ── */

  .product-list {
    max-width: 1000px;
    margin: 0 auto;
    border-top: 1px solid var(--rule);
  }

  .product-row {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    align-items: center;
    gap: 2rem;
    min-height: 105px;
    padding: 1.5rem 2rem;
    background: #ffffff;
    border-left: 3px solid transparent;
    border-bottom: 1px solid var(--rule);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .product-row:hover {
    border-left-color: var(--accent);
    transform: translateX(4px);
    box-shadow: 0 5px 18px rgba(8, 44, 34, 0.06);
  }

  .product-number {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .product-name h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--primary);
  }

  .product-action {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* ── Enquiry panel ── */

  .enquiry-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 3rem;
    background: var(--light-tint);
    border-top: 3px solid var(--accent);
  }

  .enquiry-panel h2 {
    max-width: 680px;
    margin: 0.5rem 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--primary);
  }

  .enquiry-panel p {
    max-width: 650px;
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    line-height: 1.65;
  }

  /* ── Tablet ── */

  @media (max-width: 900px) {
    .product-row {
      grid-template-columns: 70px 1fr;
    }

    .product-action {
      grid-column: 2;
    }

    .enquiry-panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  /* ── Mobile ── */

  @media (max-width: 560px) {
    .section {
      padding: 3.5rem 0;
    }

    .container {
      padding: 0 1.25rem;
    }

    .product-row {
      grid-template-columns: 45px 1fr;
      gap: 1rem;
      min-height: 90px;
      padding: 1.25rem 1rem;
    }

    .product-name h3 {
      font-size: 1.25rem;
    }

    .product-action {
      grid-column: 2;
      margin-top: -0.5rem;
    }

    .enquiry-panel {
      padding: 2rem 1.5rem;
    }
  }
</style>
