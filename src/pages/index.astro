---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import HomeHeader from "../components/home/HomeHeader.astro";
import HeroSlider from "../components/home/HeroSlider.astro";
import Introduction from "../components/home/Introduction.astro";
import ThreeThreads from "../components/home/ThreeThreads.astro";
import QualityPromise from "../components/home/QualityPromise.astro";
import WhoWeServe from "../components/home/WhoWeServe.astro";
import IngredientJourney from "../components/home/IngredientJourney.astro";
import ProductShowcase from "../components/home/ProductShowcase.astro";
import FoodStories from "../components/home/FoodStories.astro";
import TradeCTA from "../components/home/TradeCTA.astro";
import { home } from "../data/home";
import manifest from "../data/home-image-manifest.json";
import "../styles/home.css";
import serifFont from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import sansFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
const hero = home.hero.slides[0].image;
const heroImage = manifest[hero as keyof typeof manifest];
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  ogImage={home.seo.image}
  homepage
>
  <Fragment slot="head">
    <OrganizationSchema />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(min-width: 768px)"
      imagesrcset={heroImage.widths
        .map((width) => `/images/home/${hero}-${width}.avif ${width}w`)
        .join(", ")}
      imagesizes="100vw"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(max-width: 767px)"
      imagesrcset={heroImage.mobileWidths
        .map((width) => `/images/home/${hero}-mobile-${width}.avif ${width}w`)
        .join(", ")}
      imagesizes="100vw"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href={serifFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={sansFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <HomeHeader slot="header" />
  <HeroSlider />
  <Introduction />
  <ThreeThreads />
  <QualityPromise />
  <WhoWeServe />
  <IngredientJourney />
  <ProductShowcase />
  <FoodStories />
  <TradeCTA />
</BaseLayout>
<script>
  import { initHome } from "../scripts/home";
  initHome();
</script>
