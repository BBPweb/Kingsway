---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allStories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredStory = allStories[0];
const gridStories = allStories;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const streams = [
  {
    category: 'all',
    label: 'All Stories',
    count: allStories.length,
  },
  {
    category: 'Recipe',
    label: 'Recipes',
    count: allStories.filter(s => s.data.category === 'Recipe').length,
  },
  {
    category: 'Origin story',
    label: 'Origin Stories',
    count: allStories.filter(s => s.data.category === 'Origin story').length,
  },
  {
    category: 'Cooking tip',
    label: 'Cooking Tips',
    count: allStories.filter(s => s.data.category === 'Cooking tip').length,
  },
];

const newsletterEndpoint = import.meta.env.PUBLIC_FORMSPREE_NEWSLETTER ?? '';
---

<BaseLayout
  title="Food Stories & Recipes | Stories From The Fields | Kingsway International"
  description="Explore authentic recipes, origin journeys and essential cooking tips from the farms, ports and kitchens behind Kingsway International's authentic ethnic food ingredients."
>
  <!-- ══════════════════════════════════════════════════════════════════════════
       HERO SECTION: STORIES FROM THE FIELDS (Deep Navy, Royal Navy & Gold)
       ══════════════════════════════════════════════════════════════════════════ -->
  <header class="stories-hero" aria-label="Food stories introduction">
    <div class="hero-ambient-orb hero-ambient-orb--gold" aria-hidden="true"></div>
    <div class="hero-ambient-orb hero-ambient-orb--blue" aria-hidden="true"></div>

    <div class="content-container">
      <!-- Reference-Style Integrated Breadcrumb -->
      <nav class="hero-breadcrumb" aria-label="Breadcrumb navigation">
        <ol class="hero-breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" class="hero-breadcrumb-link" itemprop="item">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li aria-hidden="true" class="hero-breadcrumb-sep">/</li>
          <li class="hero-breadcrumb-current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Food stories</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>

      <div class="stories-hero-grid">

        <!-- Left Column: Big Editorial Title & Introduction -->
        <div class="stories-hero-content" data-reveal>
          <h1 class="stories-hero-title">
            Stories from<br />
            <span class="title-highlight">the fields</span>
          </h1>

          <p class="stories-hero-subtitle">
            Thoughtful reads on rice, spices, nutrition, healthy living, Kerala traditions and sustainable farming.
          </p>
        </div>

        <!-- Right Column: Hero Featured Story Card (Floated Card) -->
        {featuredStory && (
          <div class="stories-hero-featured" data-reveal>
            <article class="featured-story-card">
              <div class="featured-card-badge">
                <span class="badge-star" aria-hidden="true">★</span>
                <span>FEATURED STORY</span>
              </div>

              <a href={`/food-stories/${featuredStory.slug}`} class="featured-card-media" aria-label={`Read ${featuredStory.data.title}`}>
                <img
                  src={featuredStory.data.heroImage || '/images/foodstories1.jpeg'}
                  alt={featuredStory.data.title}
                  class="featured-img"
                  loading="eager"
                  fetchpriority="high"
                />
              </a>

              <div class="featured-card-body">
                <div class="featured-meta-row">
                  <span class="category-tag category-tag--gold">{featuredStory.data.category}</span>
                  <span class="featured-meta-dot" aria-hidden="true">·</span>
                  <time datetime={featuredStory.data.date.toISOString()} class="featured-date">
                    {dateFormatter.format(featuredStory.data.date)}
                  </time>
                  <span class="featured-meta-dot" aria-hidden="true">·</span>
                  <span class="featured-readtime">{featuredStory.data.readTime}</span>
                </div>

                <h2 class="featured-card-title">
                  <a href={`/food-stories/${featuredStory.slug}`}>
                    {featuredStory.data.title}
                  </a>
                </h2>

                <p class="featured-card-excerpt">
                  {featuredStory.data.excerpt}
                </p>

                <div class="featured-card-footer">
                  <a href={`/food-stories/${featuredStory.slug}`} class="featured-read-link">
                    <span>Read full story</span>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          </div>
        )}

      </div>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════════════════════════════════
       CONTENT STREAMS / VALUE PILLARS (Three Streams of Content)
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section-streams" aria-labelledby="streams-heading">
    <div class="content-container">
      <div class="streams-grid">
        <div class="stream-pill-box">
          <span class="stream-letter" aria-hidden="true">R</span>
          <div class="stream-content">
            <h3 class="stream-name">Authentic Recipes</h3>
            <p class="stream-desc">Ingredient-anchored recipes across South Asian, African, Middle Eastern and Caribbean cuisines.</p>
          </div>
        </div>

        <div class="stream-pill-box">
          <span class="stream-letter" aria-hidden="true">O</span>
          <div class="stream-content">
            <h3 class="stream-name">Origin Stories</h3>
            <p class="stream-desc">Where spices and grains come from, how they are harvested, and the traditions behind them.</p>
          </div>
        </div>

        <div class="stream-pill-box">
          <span class="stream-letter" aria-hidden="true">T</span>
          <div class="stream-content">
            <h3 class="stream-name">Kitchen Advice</h3>
            <p class="stream-desc">Short, practical advice on getting the best performance from staples in commercial and home kitchens.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       LATEST ARTICLES SECTION WITH INTERACTIVE SEARCH & CATEGORY FILTER
       ══════════════════════════════════════════════════════════════════════════ -->
  <section id="articles" class="section-articles" aria-labelledby="articles-heading">
    <div class="content-container">

      <!-- Header & Search Toolbar -->
      <div class="articles-header-bar" data-reveal>
        <div class="articles-headline-group">
          <span class="articles-kicker">CURATED ARCHIVE</span>
          <h2 id="articles-heading" class="articles-main-title">
            LATEST <span class="title-highlight">ARTICLES</span>
          </h2>
        </div>
        <p class="articles-header-note">
          From our origins to your kitchen, there is always a little more to discover.
        </p>
      </div>

      <!-- Filter Controls: Search & Category Filter Pills -->
      <div class="filter-toolbar" data-reveal>
        <div class="category-tabs" role="tablist" aria-label="Filter stories by category">
          {streams.map((stream) => (
            <button
              type="button"
              class={`filter-tab-btn ${stream.category === 'all' ? 'is-active' : ''}`}
              data-category={stream.category}
              role="tab"
              aria-selected={stream.category === 'all' ? 'true' : 'false'}
            >
              <span>{stream.label}</span>
              <span class="tab-count">{stream.count}</span>
            </button>
          ))}
        </div>

        <!-- Search Input -->
        <div class="search-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="story-search"
            placeholder="Search recipes, grains, spices..."
            aria-label="Search food stories"
            class="search-input"
          />
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="stories-grid" id="stories-grid" data-reveal>
        {gridStories.map((story) => (
          <article
            class="story-card"
            data-story-category={story.data.category}
            data-story-title={story.data.title.toLowerCase()}
            data-story-excerpt={story.data.excerpt.toLowerCase()}
          >
            <div class="story-card-image-wrap">
              <a href={`/food-stories/${story.slug}`} class="story-img-link" aria-label={`Read ${story.data.title}`}>
                <img
                  src={story.data.heroImage || '/images/foodstories1.jpeg'}
                  alt={story.data.title}
                  class="story-img"
                  loading="lazy"
                />
              </a>
            </div>

            <div class="story-card-body">
              <div class="story-meta-row">
                <span class={`category-tag ${
                  story.data.category === 'Recipe'
                    ? 'category-tag--gold'
                    : story.data.category === 'Origin story'
                    ? 'category-tag--navy'
                    : 'category-tag--soft'
                }`}>
                  {story.data.category}
                </span>
                <span class="meta-separator" aria-hidden="true">·</span>
                <time datetime={story.data.date.toISOString()} class="story-date">
                  {dateFormatter.format(story.data.date)}
                </time>
              </div>

              <h3 class="story-title">
                <a href={`/food-stories/${story.slug}`}>
                  {story.data.title}
                </a>
              </h3>

              <p class="story-excerpt">
                {story.data.excerpt}
              </p>

              <div class="story-footer">
                <span class="story-readtime">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {story.data.readTime}
                </span>

                <a href={`/food-stories/${story.slug}`} class="story-link-arrow">
                  <span>Read story</span>
                  <span class="arrow-up-right" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty Search Fallback State -->
      <div id="no-results-msg" class="no-results-box" style="display: none;">
        <p class="no-results-text">No articles found matching your query.</p>
        <button type="button" id="reset-filter-btn" class="btn-reset-filter">Reset Filters</button>
      </div>

      <!-- Editorial Quote Box (Goodness goes beyond the grain) -->
      <div class="goodness-callout-banner" data-reveal>
        <div class="goodness-icon-wrap" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
        </div>
        <div class="goodness-content">
          <h3 class="goodness-title">Goodness goes beyond the grain.</h3>
          <p class="goodness-text">
            All content published by Kingsway International is original, ingredient-anchored, and kitchen-tested. If a recipe calls for a specific Kingsway spice, rice variety, or oil, we tell you why, because provenance matters, and honest attribution is better than generic category mentions.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       NEWSLETTER BANNER: FRESH STORIES, FAMILIAR GOODNESS
       (Deep Navy, Royal Navy & Champagne Gold)
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section-newsletter" aria-labelledby="newsletter-headline">
    <div class="content-container">
      <div class="newsletter-card" data-reveal>
        <div class="newsletter-star-accent" aria-hidden="true">✦</div>

        <div class="newsletter-text-wrap">
          <span class="newsletter-kicker">SIGN UP FOR STORIES &amp; RECIPES</span>
          <h2 id="newsletter-headline" class="newsletter-title">
            FRESH STORIES,<br />
            FAMILIAR GOODNESS
          </h2>
          <p class="newsletter-caption">
            Get monthly updates on new products, origin stories, tested recipes, and authentic cooking tips. No spam, no promotional noise.
          </p>
        </div>

        <div class="newsletter-form-wrap">
          <form
            class="newsletter-form-row"
            action={newsletterEndpoint}
            method="POST"
          >
            <label for="stories-email" class="sr-only">Your email address</label>
            <input
              id="stories-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="Enter your email address"
              class="newsletter-text-input"
            />
            <button type="submit" class="newsletter-submit-btn">
              <span>Subscribe</span>
              <span class="btn-icon-circle-sm" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          </form>
          <p class="newsletter-disclaimer">
            We respect your inbox. You can unsubscribe at any time with one click.
          </p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- Client Filtering & Search Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.filter-tab-btn');
    const searchInput = document.getElementById('story-search');
    const cards = document.querySelectorAll('.story-card');
    const noResults = document.getElementById('no-results-msg');
    const resetBtn = document.getElementById('reset-filter-btn');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-story-category') || '';
        const cardTitle = card.getAttribute('data-story-title') || '';
        const cardExcerpt = card.getAttribute('data-story-excerpt') || '';

        const matchesCategory =
          activeCategory === 'all' ||
          cardCategory.toLowerCase() === activeCategory.toLowerCase();

        const matchesSearch =
          !searchQuery ||
          cardTitle.includes(searchQuery) ||
          cardExcerpt.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        activeCategory = tab.getAttribute('data-category') || 'all';
        filterCards();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterCards();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCategory = 'all';
        tabs.forEach((t, i) => {
          if (i === 0) {
            t.classList.add('is-active');
            t.setAttribute('aria-selected', 'true');
          } else {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          }
        });
        filterCards();
      });
    }

    // Scroll reveal animation
    const reveals = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      reveals.forEach((el) => observer.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add('is-revealed'));
    }
  });
</script>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     BASE TOKENS & TYPOGRAPHY (Navy, Royal, Gold, White, Beige, Ink)
     ══════════════════════════════════════════════════════════════════════════ */
  :root {
    --deep-navy: #0B1C36;
    --royal-navy: #173A78;
    --champagne-gold: #D9A441;
    --gold-light: #F4BF4F;
    --gold-soft-bg: rgba(217, 164, 65, 0.12);
    --gold-border: rgba(217, 164, 65, 0.35);
    --warm-white: #FAF9F6;
    --light-beige: #F1EDE5;
    --body-text: #465166;
    --heading-ink: #0B1C36;
    --subtle-rule: #E5E5E5;
    --font-serif: 'Fraunces Variable', Georgia, serif;
    --font-sans: 'Manrope Variable', system-ui, sans-serif;
  }

  .content-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     REFERENCE-STYLE INTEGRATED HERO BREADCRUMB
     ══════════════════════════════════════════════════════════════════════════ */
  .hero-breadcrumb {
    margin-bottom: 2rem;
    position: relative;
    z-index: 5;
  }

  .hero-breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .hero-breadcrumb-link {
    color: var(--body-text);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .hero-breadcrumb-link:hover {
    color: var(--royal-navy);
  }

  .hero-breadcrumb-sep {
    color: rgba(70, 81, 102, 0.45);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .hero-breadcrumb-current {
    color: var(--deep-navy);
    font-weight: 600;
  }

  /* ── Reference-Style Eyebrow with Asterisk Spark ── */
  .hero-eyebrow-row {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .hero-spark-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    color: var(--champagne-gold);
  }

  .hero-eyebrow-text {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--royal-navy);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     STORIES HERO SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .stories-hero {
    position: relative;
    background: linear-gradient(135deg, #FAF9F6 0%, #FFFFFF 50%, #F4F1E8 100%);
    padding: 4.5rem 0 5rem;
    border-bottom: 1px solid rgba(229, 229, 229, 0.6);
    overflow: hidden;
  }

  .hero-ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .hero-ambient-orb--gold {
    top: 5%;
    right: 15%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.18) 0%, transparent 70%);
  }

  .hero-ambient-orb--blue {
    bottom: -10%;
    left: 5%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(23, 58, 120, 0.08) 0%, transparent 70%);
  }

  .stories-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4.5rem;
    align-items: center;
  }

  /* Left Kicker */
  .kicker-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid var(--gold-border);
    padding: 0.45rem 1.1rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 12px rgba(217, 164, 65, 0.12);
  }

  .kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
    box-shadow: 0 0 8px var(--champagne-gold);
  }

  .kicker-text {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--deep-navy);
  }

  .stories-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 4vw, 3.65rem);
    line-height: 1.12;
    font-weight: 400;
    color: var(--deep-navy);
    margin: 0 0 1.25rem;
    letter-spacing: -0.015em;
  }

  .title-highlight {
    color: var(--champagne-gold);
    font-style: italic;
  }

  .stories-hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 1.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--deep-navy);
    font-weight: 600;
    margin: 0 0 1.25rem;
    max-width: 580px;
  }

  .stories-hero-lede {
    font-family: var(--font-sans);
    font-size: 0.9625rem;
    line-height: 1.7;
    color: var(--body-text);
    margin: 0 0 2rem;
    max-width: 560px;
    border-left: 3px solid var(--champagne-gold);
    padding-left: 1rem;
  }

  .stories-hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Gold Button */
  .btn-primary-gold {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background-color: var(--champagne-gold);
    color: var(--deep-navy);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 6px 18px -2px rgba(217, 164, 65, 0.45);
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-primary-gold:hover {
    background-color: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -2px rgba(217, 164, 65, 0.6);
  }

  .btn-icon-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
