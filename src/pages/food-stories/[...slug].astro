---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import BlogPostingSchema from '../../components/schema/BlogPostingSchema.astro';

export async function getStaticPaths() {
  const stories = (await getCollection('stories', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return stories.map((story, idx) => ({
    params: { slug: story.slug },
    props: {
      story,
      newer: idx > 0 ? stories[idx - 1] : null,
      older: idx < stories.length - 1 ? stories[idx + 1] : null,
      related: stories.filter((s) => s.slug !== story.slug).slice(0, 3),
    },
  }));
}

interface Props {
  story: CollectionEntry<'stories'>;
  newer: CollectionEntry<'stories'> | null;
  older: CollectionEntry<'stories'> | null;
  related: CollectionEntry<'stories'>[];
}

const { story, newer, older, related } = Astro.props;
const { Content } = await story.render();

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formattedDate = dateFormatter.format(story.data.date);
const heroImageSrc = story.data.heroImage || '/images/foodstories1.jpeg';
---

<BaseLayout
  title={`${story.data.title} | Food Stories | Kingsway International`}
  description={story.data.excerpt}
  ogType="article"
>
  <BlogPostingSchema
    slot="head"
    headline={story.data.title}
    description={story.data.excerpt}
    datePublished={story.data.date}
    slug={story.slug}
    category={story.data.category}
  />

  <!-- Editorial Article Header -->
  <header class="story-header" aria-labelledby="story-title">
    <div class="story-header-inner">
      <!-- Reference-Style Integrated Breadcrumb -->
      <nav class="hero-breadcrumb" aria-label="Breadcrumb navigation">
        <ol class="hero-breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" class="hero-breadcrumb-link" itemprop="item">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li aria-hidden="true" class="hero-breadcrumb-sep">/</li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/food-stories" class="hero-breadcrumb-link" itemprop="item">
              <span itemprop="name">Food stories</span>
            </a>
            <meta itemprop="position" content="2" />
          </li>
          <li aria-hidden="true" class="hero-breadcrumb-sep">/</li>
          <li class="hero-breadcrumb-current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">{story.data.title}</span>
            <meta itemprop="position" content="3" />
          </li>
        </ol>
      </nav>

      <div class="header-meta-row">
        <span class={`category-badge category-badge--${story.data.category.toLowerCase().replace(/\s+/g, '-')}`}>
          {story.data.category}
        </span>
        <span class="meta-dot" aria-hidden="true">&bull;</span>
        <span class="reading-time">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          {story.data.readTime}
        </span>
        <span class="meta-dot" aria-hidden="true">&bull;</span>
        <time datetime={story.data.date.toISOString()} class="publish-date">
          {formattedDate}
        </time>
      </div>

      <h1 id="story-title" class="story-title">{story.data.title}</h1>

      <div class="story-lead-card">
        <div class="lead-gold-bar" aria-hidden="true"></div>
        <p class="story-lead-text">{story.data.excerpt}</p>
      </div>

      <!-- Sculpted Organic Hero Image -->
      <div class="hero-image-wrap">
        <div class="hero-image-sculpture">
          <img
            src={heroImageSrc}
            alt={story.data.title}
            class="hero-img"
            loading="eager"
            decoding="async"
          />
          <div class="hero-curved-overlay" aria-hidden="true"></div>
          <div class="hero-floating-pill">
            <span class="gold-spark" aria-hidden="true"></span>
            <span>Kingsway Heritage & Culinary Insights</span>
          </div>
        </div>
        <div class="halo-backdrop" aria-hidden="true"></div>
      </div>
    </div>
  </header>

  <!-- Main Article Body -->
  <main class="story-main" aria-label="Story article content">
    <div class="story-content-layout">
      <!-- Article Content Column -->
      <article class="story-article">
        <div class="story-body-inner">
          <Content />
        </div>

        <!-- Provenance & Quality Callout Card -->
        <div class="provenance-card">
          <div class="provenance-seal">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div class="provenance-content">
            <span class="provenance-eyebrow">Kingsway Quality Guarantee</span>
            <h3 class="provenance-heading">Direct Origin Traceability & Commercial Standards</h3>
            <p class="provenance-text">
              Every spice, grain, pulse and cooking ingredient featured in our Food Stories is sourced through verified global producers and subjected to rigorous intake inspection at our Leicester distribution depot.
            </p>
            <div class="provenance-tags">
              <span class="provenance-tag">Direct Farm Relations</span>
              <span class="provenance-tag">UK Intake Quality Testing</span>
              <span class="provenance-tag">Wholesale & Food Service Ready</span>
            </div>
          </div>
        </div>

        <!-- Story Action Bar -->
        <div class="story-action-bar">
          <a href="/food-stories" class="action-btn-back">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to all Food Stories</span>
          </a>
          <a href="/contact" class="action-btn-enquire">
            <span>Enquire about commercial supply</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>
    </div>
  </main>

  <!-- Editorial Pagination / More Stories Section -->
  <section class="more-stories-section" aria-labelledby="more-stories-title">
    <div class="more-stories-container">
      <div class="more-stories-header">
        <span class="more-eyebrow">Culinary Archives</span>
        <h2 id="more-stories-title" class="more-heading">Continue Reading</h2>
      </div>

      <div class="more-stories-grid">
        {older && (
          <a href={`/food-stories/${older.slug}`} class="story-nav-card story-nav-card--older">
            <div class="nav-direction">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Previous Story</span>
            </div>
            <span class="nav-category">{older.data.category}</span>
            <h3 class="nav-title">{older.data.title}</h3>
            <p class="nav-excerpt">{older.data.excerpt}</p>
          </a>
        )}

        {newer && (
          <a href={`/food-stories/${newer.slug}`} class="story-nav-card story-nav-card--newer">
            <div class="nav-direction">
              <span>Next Story</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
            <span class="nav-category">{newer.data.category}</span>
            <h3 class="nav-title">{newer.data.title}</h3>
            <p class="nav-excerpt">{newer.data.excerpt}</p>
          </a>
        )}
      </div>

      <!-- Additional Recommended Stories If Only One Or None In Normal Paginate -->
      {related && related.length > 0 && (
        <div class="related-strip">
          <h3 class="related-title">More From Our Trade Specialists</h3>
          <div class="related-grid">
            {related.slice(0, 3).map((item) => (
              <a href={`/food-stories/${item.slug}`} class="related-card">
                <div class="related-image-frame">
                  <img
                    src={item.data.heroImage || '/images/foodstories1.jpeg'}
                    alt={item.data.title}
                    class="related-img"
                    loading="lazy"
                  />
                  <span class="related-badge">{item.data.category}</span>
                </div>
                <div class="related-info">
                  <span class="related-readtime">{item.data.readTime}</span>
                  <h4 class="related-heading">{item.data.title}</h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Trade CTA Banner -->
  <CTABanner
    heading="Start a trade conversation"
    caption="We answer every enquiry within one business day."
    buttonLabel="Send an enquiry"
    buttonHref="/contact"
  />
</BaseLayout>

<style>
  :root {
    --deep-navy: #0B1C36;
    --royal-navy: #173A78;
    --champagne-gold: #D9A441;
    --gold-light: #F4BF4F;
    --gold-soft-bg: rgba(217, 164, 65, 0.12);
    --gold-border: rgba(217, 164, 65, 0.35);
    --warm-white: #FAF9F6;
    --light-beige: #F1EDE5;
    --body-text: #465166;
    --heading-ink: #0B1C36;
    --subtle-rule: #E5E5E5;
  }

  /* ── Reference-Style Integrated Hero Breadcrumb ── */
  .hero-breadcrumb {
    margin-bottom: 2rem;
    position: relative;
    z-index: 5;
  }

  .hero-breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .hero-breadcrumb-link {
    color: var(--body-text);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .hero-breadcrumb-link:hover {
    color: var(--royal-navy);
  }

  .hero-breadcrumb-sep {
    color: rgba(70, 81, 102, 0.45);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .hero-breadcrumb-current {
    color: var(--deep-navy);
    font-weight: 600;
    max-width: 480px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── 2. Editorial Header ── */
  .story-header {
    background: linear-gradient(180deg, var(--warm-white) 0%, #ffffff 100%);
    padding: 3.5rem 0 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .story-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .story-header-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 2;
  }

  .header-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .category-badge {
    display: inline-block;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .category-badge--recipe {
    background: rgba(217, 164, 65, 0.15);
    color: var(--deep-navy);
    border: 1px solid rgba(217, 164, 65, 0.4);
  }

  .category-badge--origin-story {
    background: rgba(23, 58, 120, 0.10);
    color: var(--royal-navy);
    border: 1px solid rgba(23, 58, 120, 0.25);
  }

  .category-badge--cooking-tip {
    background: rgba(11, 28, 54, 0.08);
    color: var(--deep-navy);
    border: 1px solid rgba(11, 28, 54, 0.2);
  }

  .meta-dot {
    color: rgba(217, 164, 65, 0.7);
    font-size: 14px;
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 13px;
    font-weight: 600;
    color: var(--body-text);
  }

  .publish-date {
    font-size: 13px;
    color: var(--body-text);
    font-weight: 500;
  }

  .story-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.35rem, 4vw, 3.65rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--heading-ink);
    margin: 0 0 1.75rem;
  }

  .story-lead-card {
    position: relative;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--gold-border);
    border-radius: 18px;
    padding: 1.5rem 1.85rem;
    margin-bottom: 2.75rem;
    box-shadow: 0 12px 32px rgba(11, 28, 54, 0.05);
    display: flex;
    gap: 1.25rem;
  }

  .lead-gold-bar {
    width: 4px;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--champagne-gold) 0%, var(--gold-light) 100%);
    flex-shrink: 0;
  }

  .story-lead-text {
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.65;
    color: var(--body-text);
    margin: 0;
    font-style: normal;
    font-weight: 400;
  }

  /* ── Sculpted Organic Hero Image ── */
  .hero-image-wrap {
    position: relative;
    margin-top: 1rem;
  }

  .hero-image-sculpture {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 520px;
    border-radius: 28px 100px 28px 70px;
    overflow: hidden;
    box-shadow: 
      0 0 0 1px var(--gold-border),
      0 24px 50px -12px rgba(11, 28, 54, 0.22);
    background-color: var(--deep-navy);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-image-sculpture:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-curved-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(11, 28, 54, 0.65) 100%);
    pointer-events: none;
  }

  .hero-floating-pill {
    position: absolute;
    bottom: 1.5rem;
    left: 1.75rem;
    background: rgba(11, 28, 54, 0.88);
    backdrop-filter: blur(10px);
    border: 1px solid var(--gold-border);
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 12px;
    font-weight: 600;
    color: var(--warm-white);
    letter-spacing: 0.05em;
  }

  .gold-spark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--champagne-gold);
    box-shadow: 0 0 10px var(--gold-light);
  }

  /* ── 3. Main Article Body ── */
  .story-main {
    background-color: #ffffff;
    padding: 3.5rem 0 5rem;
  }

  .story-content-layout {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .story-body-inner {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.8;
    color: var(--body-text);
  }

  .story-body-inner :global(p) {
    margin: 0 0 1.75rem;
  }

  .story-body-inner :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(26px, 3.2vw, 34px);
    line-height: 1.25;
    color: var(--heading-ink);
    margin: 3.25rem 0 1.25rem;
    position: relative;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gold-border);
  }

  .story-body-inner :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.35;
    color: var(--deep-navy);
    margin: 2.5rem 0 1rem;
  }

  .story-body-inner :global(ul),
  .story-body-inner :global(ol) {
    margin: 0 0 2rem;
    padding-left: 1.5rem;
  }

  .story-body-inner :global(li) {
    margin-bottom: 0.75rem;
    position: relative;
  }

  .story-body-inner :global(ul > li::marker) {
    color: var(--champagne-gold);
  }

  .story-body-inner :global(blockquote) {
    background: var(--warm-white);
    border-left: 4px solid var(--champagne-gold);
    border-radius: 0 16px 16px 0;
    padding: 1.5rem 1.85rem;
    margin: 2.5rem 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.6;
    color: var(--deep-navy);
    box-shadow: 0 6px 20px rgba(11, 28, 54, 0.04);
  }

  .story-body-inner :global(blockquote p) {
    margin: 0;
  }

  .story-body-inner :global(a) {
    color: var(--royal-navy);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1.5px solid var(--gold-border);
    padding-bottom: 1px;
    transition: all 0.2s ease;
  }

  .story-body-inner :global(a:hover) {
    color: var(--deep-navy);
    border-bottom-color: var(--champagne-gold);
  }

  /* ── 4. Provenance & Quality Callout Card ── */
  .provenance-card {
    margin: 4rem 0 3rem;
    background: linear-gradient(145deg, var(--deep-navy) 0%, #102649 100%);
    border: 1px solid var(--gold-border);
    border-radius: 24px;
    padding: 2.25rem 2.25rem;
    display: flex;
    gap: 1.5rem;
    color: var(--warm-white);
    box-shadow: 0 20px 45px rgba(11, 28, 54, 0.16);
    position: relative;
    overflow: hidden;
  }

  .provenance-card::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .provenance-seal {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--gold-soft-bg);
    border: 1px solid var(--gold-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--champagne-gold);
    flex-shrink: 0;
  }

  .provenance-content {
    flex: 1;
  }

  .provenance-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champagne-gold);
    display: block;
    margin-bottom: 0.5rem;
  }

  .provenance-heading {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.3;
    color: var(--warm-white);
    margin: 0 0 0.85rem;
  }

  .provenance-text {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(250, 249, 246, 0.85);
    margin: 0 0 1.25rem;
  }

  .provenance-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .provenance-tag {
    font-size: 12px;
    font-weight: 600;
    color: var(--gold-light);
    background: rgba(217, 164, 65, 0.12);
    border: 1px solid rgba(217, 164, 65, 0.25);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  /* ── 5. Story Action Bar ── */
  .story-action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--subtle-rule);
    flex-wrap: wrap;
  }

  .action-btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 14px;
    font-weight: 700;
    color: var(--royal-navy);
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: var(--warm-white);
    border: 1px solid var(--gold-border);
    transition: all 0.2s ease;
  }

  .action-btn-back:hover {
    background: #ffffff;
    border-color: var(--champagne-gold);
    transform: translateX(-3px);
  }

  .action-btn-enquire {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 14px;
    font-weight: 700;
    color: var(--deep-navy);
    background: linear-gradient(135deg, var(--champagne-gold) 0%, var(--gold-light) 100%);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(217, 164, 65, 0.35);
    transition: all 0.2s ease;
  }

  .action-btn-enquire:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(217, 164, 65, 0.45);
  }

  /* ── 6. Editorial Pagination & Archives ── */
  .more-stories-section {
    background-color: var(--warm-white);
    border-top: 1px solid var(--gold-border);
    padding: 5rem 0 6rem;
  }

  .more-stories-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .more-stories-header {
    margin-bottom: 2.75rem;
    text-align: center;
  }

  .more-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
